diagram LRE_Beh

enumeration Close { Close_v0 Close_v1 }
enumeration Obstacle { Obstacle_v0 Obstacle_v1 }

interface Inputs {
	event endTask
	event reqOCM
	event reqMOM
	event reqHCM
	event reqVel
	event reqHdng
}

interface Outputs {
	event advVel
	event advHdng
}

interface LRE_Beh_State {
	var hvel : real
	var odist_cdyn : real
	var odist_cstc : real
	var inOPEZ : boolean
	var CDA : real
	var TCPA : real
	var hdist_cstc : real
	var vdist_cstc : real
	var vvel : real
}

interface Constants {
	const MinSafeDist : real = 1
	const StaticObsHorizDist : real = 1
	const StaticObsDfltVertDist : real = 1
	const StaticObsVertDist : real = 1
}

stm LRE_Beh {
	uses Inputs uses Outputs requires LRE_Beh_State requires Constants
	state HCM {
		entry send advVel
	}
	state MOM {
		entry send advVel
	}
	state OCM {
	}
	state CAM {
	}
	initial i0
	transition t0 {
		from i0
		to OCM
	}
	transition t1 {
		from OCM
		to OCM
		trigger reqVel
		action send advVel
	}
	transition t2 {
		from OCM
		to OCM
		trigger reqHdng
		action send advHdng
	}
	transition t3 {
		from OCM
		to MOM
		trigger reqMOM
		condition hvel < 1 /\ odist_cdyn > 8 /\ odist_cstc > 1 /\ not ( inOPEZ )
	}
	transition t4 {
		from MOM
		to OCM
		condition inOPEZ
	}
	transition t5 {
		from MOM
		to OCM
		trigger reqOCM
	}
	transition t6 {
		from MOM
		to CAM
		condition CDA < MinSafeDist /\ TCPA >= 0
	}
	transition t7 {
		from MOM
		to OCM
		trigger endTask
		action send advVel
	}
	transition t8 {
		from MOM
		to HCM
		condition hvel >= 1 /\ hdist_cstc < StaticObsHorizDist
	}
	transition t9 {
		from MOM
		to HCM
		condition vdist_cstc <= StaticObsDfltVertDist
	}
	transition t10 {
		from MOM
		to HCM
		condition vvel >= 1 /\ hdist_cstc < StaticObsVertDist
	}
	transition t11 {
		from MOM
		to HCM
		trigger reqHCM
	}
	transition t12 {
		from HCM
		to MOM
		condition hdist_cstc > StaticObsHorizDist /\ vdist_cstc > StaticObsVertDist
	}
	transition t13 {
		from HCM
		to CAM
		condition CDA < MinSafeDist /\ TCPA >= 0
	}
	transition t14 {
		from HCM
		to OCM
		trigger reqOCM
	}
	transition t15 {
		from HCM
		to OCM
		condition inOPEZ
	}
	transition t16 {
		from CAM
		to OCM
		trigger reqOCM
	}
	transition t17 {
		from CAM
		to OCM
		condition CDA >= MinSafeDist
	}
}

controller LRE_Beh_Ctrl {
	uses Inputs uses Outputs requires LRE_Beh_State requires Constants
	sref stm_ref0 = LRE_Beh
	connection LRE_Beh_Ctrl on endTask to stm_ref0 on endTask
	connection LRE_Beh_Ctrl on reqOCM to stm_ref0 on reqOCM
	connection LRE_Beh_Ctrl on reqMOM to stm_ref0 on reqMOM
	connection LRE_Beh_Ctrl on reqHCM to stm_ref0 on reqHCM
	connection LRE_Beh_Ctrl on reqVel to stm_ref0 on reqVel
	connection LRE_Beh_Ctrl on reqHdng to stm_ref0 on reqHdng
	connection stm_ref0 on advVel to LRE_Beh_Ctrl on advVel
	connection stm_ref0 on advHdng to LRE_Beh_Ctrl on advHdng
}

module LRE_Beh_Module {
	robotic platform LRE_Beh_Platform {
		provides Constants
		event endTask
		event reqOCM
		event reqMOM
		event reqHCM
		event reqVel
		event reqHdng
		event advVel
		event advHdng
	}
	cref ctrl_ref0 = LRE_Beh_Ctrl
	connection LRE_Beh_Platform on endTask to ctrl_ref0 on endTask
	connection LRE_Beh_Platform on reqOCM to ctrl_ref0 on reqOCM
	connection LRE_Beh_Platform on reqMOM to ctrl_ref0 on reqMOM
	connection LRE_Beh_Platform on reqHCM to ctrl_ref0 on reqHCM
	connection LRE_Beh_Platform on reqVel to ctrl_ref0 on reqVel
	connection LRE_Beh_Platform on reqHdng to ctrl_ref0 on reqHdng
	connection ctrl_ref0 on advVel to LRE_Beh_Platform on advVel
	connection ctrl_ref0 on advHdng to LRE_Beh_Platform on advHdng
}

