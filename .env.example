# Copy this file to .env at the repo root and fill in real values.
# .env is gitignored; .env.example is committed.

# OpenAI or any OpenAI-compatible endpoint (DeepSeek, vLLM, OpenRouter, ...).
# Set OPENAI_API_BASE to the provider's base URL.
OPENAI_API_KEY=your-openai-or-compatible-key-here
OPENAI_API_BASE=https://api.openai.com/v1

# Optional — only required if a stage's config.yaml uses api_type: "anthropic"
# ANTHROPIC_API_KEY=your-anthropic-key-here
