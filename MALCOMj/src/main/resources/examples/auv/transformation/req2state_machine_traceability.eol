"Transformation starting...".println();

var source_metamodel = "\\metamodel\\base.ecore,\\metamodel\\requirement.ecore".split(",");
var target_metamodel = "\\metamodel\\robochart.ecore".split(",");

// create trace package
var tracePackage = new B!TracePackage;
tracePackage.name = "Req2StateMachine";
tracePackage.gid = "RBP1";

var source_model = S.getModelFileUri()+"";
var target_model = T.getModelFileUri()+"";

var skipped = 0;
for (entry in J.root.stm_trace) {
	var gid = entry.requirement_gid;

	// stm_trace entries with all-null state/transition are non-behavioural
	// requirements (e.g. functional/non-functional) — skip them silently.
	if (entry.source_state = null and entry.end_state = null and entry.transition = null) {
		skipped = skipped + 1;
		continue;
	}

	if (entry.transition <> null) {
		createReqTransitionBridge(gid, entry.transition);
	}
	if (entry.source_state <> null) {
		createReqNodeBridge(gid, entry.source_state, "source");
	}
	if (entry.end_state <> null and entry.end_state <> entry.source_state) {
		createReqNodeBridge(gid, entry.end_state, "end");
	}
}

("Created " + tracePackage.traceElement.select(s|s.isTypeOf(B!Trace)).size()
 + " trace(s); skipped " + skipped + " non-behavioural entries.").println();
"Transformation finished!".println();


operation lookupRequirement(gid) {
	var s = S!Requirement.all.select(r|r.gid = gid).first();
	if (s.isUndefined()) {
		("WARNING: No requirement found with GID " + gid + ", skipping bridge.").println();
	}
	return s;
}

operation buildSourceRef(s) {
	var er = new B!ExternalReference;
	er.location = source_model;
	er.type = "EMF";
	er.metadata.addAll(source_metamodel);
	er.version = (s.getName() + "-" + s.getGid() + "-" + s.getDescription()).hashCode().toString();
	er.constraints.add("S!Requirement.all.select(r|r.gid = \"" + s.gid + "\").first();");
	return er;
}

operation createReqTransitionBridge(gid, transitionName) {
	var s = lookupRequirement(gid);
	if (s.isUndefined()) return;

	var t = T!Transition.all.select(x|x.name = transitionName).first();
	if (t.isUndefined()) {
		("WARNING: Transition " + transitionName + " not found in target model.").println();
		return;
	}

	var trace = new B!Trace;
	trace.name = gid + "_TO_" + transitionName;
	trace.source = buildSourceRef(s);

	var er = new B!ExternalReference;
	er.location = target_model;
	er.type = "EMF";
	er.metadata.addAll(target_metamodel);
	er.version = transitionName.hashCode().toString();
	er.constraints.add("T!Transition.all.select(x|x.name = \"" + transitionName + "\").first();");
	trace.target = er;

	tracePackage.traceElement.add(trace);
}

operation createReqNodeBridge(gid, nodeName, role) {
	var s = lookupRequirement(gid);
	if (s.isUndefined()) return;

	// Could be a State or an Initial junction — both subtypes of Node.
	var node = T!Node.all.select(x|x.name = nodeName).first();
	if (node.isUndefined()) {
		("WARNING: Node " + nodeName + " (" + role + ") not found in target model.").println();
		return;
	}

	var trace = new B!Trace;
	trace.name = gid + "_TO_" + nodeName + "(" + role + ")";
	trace.source = buildSourceRef(s);

	var er = new B!ExternalReference;
	er.location = target_model;
	er.type = "EMF";
	er.metadata.addAll(target_metamodel);
	er.version = nodeName.hashCode().toString();
	er.constraints.add("T!Node.all.select(x|x.name = \"" + nodeName + "\").first();");
	trace.target = er;

	tracePackage.traceElement.add(trace);
}

operation Any getDescription() {
	if (self.description.isUndefined() or self.description.content.isUndefined()
		or self.description.content.value.isEmpty()) {
		return "";
	}
	return self.description.content.value.at(0).content;
}

operation Any getName() {
	return self.name.content;
}

operation Any getGid() {
	return self.gid;
}
