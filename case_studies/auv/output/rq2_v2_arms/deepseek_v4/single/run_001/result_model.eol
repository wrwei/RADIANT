var auvModule = new M!Module;
auvModule.name = "AUV_Module";

var nat = new M!PrimitiveType;
nat.name = "nat";
auvModule.primitiveTypes.add(nat);

var intType = new M!PrimitiveType;
intType.name = "int";
auvModule.primitiveTypes.add(intType);

var stringType = new M!PrimitiveType;
stringType.name = "string";
auvModule.primitiveTypes.add(stringType);

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";
auvModule.primitiveTypes.add(booleanType);

var real = new M!PrimitiveType;
real.name = "real";
auvModule.primitiveTypes.add(real);

var svec = new M!CompositeType;
svec.name = "SVec";
auvModule.compositeTypes.add(svec);

var radial = new M!Value;
radial.name = "radial";
radial.valueType = real;
svec.values.add(radial);

var polar = new M!Value;
polar.name = "polar";
polar.valueType = real;
svec.values.add(polar);

var azimuth = new M!Value;
azimuth.name = "azimuth";
azimuth.valueType = real;
svec.values.add(azimuth);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";
auvModule.compositeTypes.add(obstacle);

var ns_rel_dist = new M!Value;
ns_rel_dist.name = "ns_rel_dist";
ns_rel_dist.valueType = real;
obstacle.values.add(ns_rel_dist);

var ew_rel_dist = new M!Value;
ew_rel_dist.name = "ew_rel_dist";
ew_rel_dist.valueType = real;
obstacle.values.add(ew_rel_dist);

var obstacle_depth = new M!Value;
obstacle_depth.name = "depth";
obstacle_depth.valueType = real;
obstacle.values.add(obstacle_depth);

var obstacle_id = new M!Value;
obstacle_id.name = "id";
obstacle_id.valueType = real;
obstacle.values.add(obstacle_id);

var obs_hdng = new M!Value;
obs_hdng.name = "obs_hdng";
obs_hdng.valueType = svec;
obstacle.values.add(obs_hdng);

var close = new M!CompositeType;
close.name = "Close";
auvModule.compositeTypes.add(close);

var horiz_cda = new M!Value;
horiz_cda.name = "horiz_cda";
horiz_cda.valueType = real;
close.values.add(horiz_cda);

var vert_cda = new M!Value;
vert_cda.name = "vert_cda";
vert_cda.valueType = real;
close.values.add(vert_cda);

var close_id = new M!Value;
close_id.name = "id";
close_id.valueType = nat;
close.values.add(close_id);

var sensors = new M!Interface;
sensors.name = "Sensors";
auvModule.interfaces.add(sensors);

var sensors_depth = new M!Value;
sensors_depth.name = "depth";
sensors_depth.valueType = real;
sensors.values.add(sensors_depth);

var hdng = new M!Value;
hdng.name = "hdng";
hdng.valueType = svec;
sensors.values.add(hdng);

var obs = new M!Value;
obs.name = "obs";
obs.valueType = obstacle;
sensors.values.add(obs);

var actuators = new M!Interface;
actuators.name = "Actuators";
auvModule.interfaces.add(actuators);

var inputs = new M!Interface;
inputs.name = "Inputs";
auvModule.interfaces.add(inputs);

var intpus = new M!Interface;
intpus.name = "Intpus";
auvModule.interfaces.add(intpus);

var endTask = new M!Event;
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
var reqVelReturn = new M!ReturnValue;
reqVelReturn.name = "return";
reqVelReturn.valueType = real;
reqVel.returnValue = reqVelReturn;
intpus.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
var reqHdngReturn = new M!ReturnValue;
reqHdngReturn.name = "return";
reqHdngReturn.valueType = real;
reqHdng.returnValue = reqHdngReturn;
intpus.events.add(reqHdng);

var outputs = new M!Interface;
outputs.name = "Outputs";
auvModule.interfaces.add(outputs);

var advVel = new M!Event;
advVel.name = "advVel";
var advVelParam = new M!Parameter;
advVelParam.name = "param";
advVelParam.valueType = real;
advVel.parameters.add(advVelParam);
outputs.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";
var advHdngParam = new M!Parameter;
advHdngParam.name = "param";
advHdngParam.valueType = real;
advHdng.parameters.add(advHdngParam);
outputs.events.add(advHdng);

var auvPlatform = new M!RoboticPlatform;
auvPlatform.name = "AUV_Platform";
auvModule.platforms.add(auvPlatform);
auvPlatform.interfaces.add(sensors);
auvPlatform.interfaces.add(actuators);

var auvOperator = new M!Controller;
auvOperator.name = "AUV_Operator";
auvModule.controllers.add(auvOperator);
auvOperator.interfaces.add(inputs);

var lreCtrl = new M!Controller;
lreCtrl.name = "LRE_Ctrl";
auvModule.controllers.add(lreCtrl);
lreCtrl.interfaces.add(inputs);
lreCtrl.interfaces.add(outputs);

var auvAutopilot = new M!Controller;
auvAutopilot.name = "AUV_Autopilot";
auvModule.controllers.add(auvAutopilot);
auvAutopilot.interfaces.add(outputs);

var odist = new M!Function;
odist.name = "odist";
var odistParam = new M!Parameter;
odistParam.name = "obstacle";
odistParam.valueType = obstacle;
odist.parameters.add(odistParam);
var odistReturn = new M!ReturnValue;
odistReturn.name = "return";
odistReturn.valueType = real;
odist.returnValue = odistReturn;
auvModule.functions.add(odist);

var hdist = new M!Function;
hdist.name = "hdist";
var hdistParam = new M!Parameter;
hdistParam.name = "obstacle";
hdistParam.valueType = obstacle;
hdist.parameters.add(hdistParam);
var hdistReturn = new M!ReturnValue;
hdistReturn.name = "return";
hdistReturn.valueType = real;
hdist.returnValue = hdistReturn;
auvModule.functions.add(hdist);

var vdist = new M!Function;
vdist.name = "vdist";
var vdistParam = new M!Parameter;
vdistParam.name = "obstacle";
vdistParam.valueType = obstacle;
vdist.parameters.add(vdistParam);
var vdistReturn = new M!ReturnValue;
vdistReturn.name = "return";
vdistReturn.valueType = real;
vdist.returnValue = vdistReturn;
auvModule.functions.add(vdist);