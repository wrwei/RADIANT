<?xml version="1.0" encoding="ASCII"?>
<mm:Module xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mm="http://generated/mm" name="AUV_Module">
  <platforms name="AUV_Platform" usedInterfaces="//@interfaces.0 //@interfaces.1"/>
  <controllers name="AUV_Operator" usedInterfaces="//@interfaces.2"/>
  <controllers name="LRE_Ctrl" usedInterfaces="//@interfaces.2 //@interfaces.4"/>
  <controllers name="AUV_Autopilot" usedInterfaces="//@interfaces.4"/>
  <interfaces name="Sensors">
    <values name="depth" type="//@types.4"/>
    <values name="hdng" type="//@types.5"/>
    <values name="obs" type="//@types.6"/>
  </interfaces>
  <interfaces name="Actuators"/>
  <interfaces name="Inputs"/>
  <interfaces name="Intpus">
    <events name="endTask"/>
    <events name="reqOCM"/>
    <events name="reqMOM"/>
    <events name="reqHCM"/>
    <events name="reqVel">
      <returnValue name="ret" type="//@types.4"/>
    </events>
    <events name="reqHdng">
      <returnValue name="ret" type="//@types.4"/>
    </events>
  </interfaces>
  <interfaces name="Outputs">
    <events name="advVel">
      <parameters name="value" type="//@types.4"/>
    </events>
    <events name="advHdng">
      <parameters name="value" type="//@types.4"/>
    </events>
  </interfaces>
  <types xsi:type="mm:PrimitiveType" name="nat"/>
  <types xsi:type="mm:PrimitiveType" name="int"/>
  <types xsi:type="mm:PrimitiveType" name="string"/>
  <types xsi:type="mm:PrimitiveType" name="boolean"/>
  <types xsi:type="mm:PrimitiveType" name="real"/>
  <types xsi:type="mm:CompositeType" name="SVec">
    <values name="radial" type="//@types.4"/>
    <values name="polar" type="//@types.4"/>
    <values name="azimuth" type="//@types.4"/>
  </types>
  <types xsi:type="mm:CompositeType" name="Obstacle">
    <values name="ns_rel_dist" type="//@types.4"/>
    <values name="ew_rel_dist" type="//@types.4"/>
    <values name="depth" type="//@types.4"/>
    <values name="id" type="//@types.4"/>
    <values name="obs_hdng" type="//@types.5"/>
  </types>
  <types xsi:type="mm:CompositeType" name="Close">
    <values name="horiz_cda" type="//@types.4"/>
    <values name="vert_cda" type="//@types.4"/>
    <values name="id" type="//@types.0"/>
  </types>
  <functions name="odist" returnType="//@types.4">
    <parameters name="obstacle" type="//@types.6"/>
  </functions>
  <functions name="hdist" returnType="//@types.4">
    <parameters name="obstacle" type="//@types.6"/>
  </functions>
  <functions name="vdist" returnType="//@types.4">
    <parameters name="obstacle" type="//@types.6"/>
  </functions>
</mm:Module>
