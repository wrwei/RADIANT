var module = new M!Module;
module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";
module.platforms.add(auv_platform);

var sensors = new M!Interface;
sensors.name = "Sensors";
module.interfaces.add(sensors);

var actuators = new M!Interface;
actuators.name = "Actuators";
module.interfaces.add(actuators);

var inputs = new M!Interface;
inputs.name = "Inputs";
module.interfaces.add(inputs);

var outputs = new M!Interface;
outputs.name = "Outputs";
module.interfaces.add(outputs);

var intpus = new M!Interface;
intpus.name = "Intpus";
module.interfaces.add(intpus);

auv_platform.usedInterfaces.add(sensors);
auv_platform.usedInterfaces.add(actuators);

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";
module.controllers.add(auv_operator);
auv_operator.usedInterfaces.add(inputs);

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";
module.controllers.add(lre_ctrl);
lre_ctrl.usedInterfaces.add(inputs);
lre_ctrl.usedInterfaces.add(outputs);

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";
module.controllers.add(auv_autopilot);
auv_autopilot.usedInterfaces.add(outputs);

var natType = new M!PrimitiveType;
natType.name = "nat";
module.types.add(natType);

var intType = new M!PrimitiveType;
intType.name = "int";
module.types.add(intType);

var stringType = new M!PrimitiveType;
stringType.name = "string";
module.types.add(stringType);

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";
module.types.add(booleanType);

var realType = new M!PrimitiveType;
realType.name = "real";
module.types.add(realType);

var svec = new M!CompositeType;
svec.name = "SVec";
module.types.add(svec);

var radial = new M!Value;
radial.name = "radial";
radial.type = realType;
svec.values.add(radial);

var polar = new M!Value;
polar.name = "polar";
polar.type = realType;
svec.values.add(polar);

var azimuth = new M!Value;
azimuth.name = "azimuth";
azimuth.type = realType;
svec.values.add(azimuth);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";
module.types.add(obstacle);

var ns_rel_dist = new M!Value;
ns_rel_dist.name = "ns_rel_dist";
ns_rel_dist.type = realType;
obstacle.values.add(ns_rel_dist);

var ew_rel_dist = new M!Value;
ew_rel_dist.name = "ew_rel_dist";
ew_rel_dist.type = realType;
obstacle.values.add(ew_rel_dist);

var obs_depth = new M!Value;
obs_depth.name = "depth";
obs_depth.type = realType;
obstacle.values.add(obs_depth);

var obs_id = new M!Value;
obs_id.name = "id";
obs_id.type = realType;
obstacle.values.add(obs_id);

var obs_hdng = new M!Value;
obs_hdng.name = "obs_hdng";
obs_hdng.type = svec;
obstacle.values.add(obs_hdng);

var sensor_depth = new M!Value;
sensor_depth.name = "depth";
sensor_depth.type = realType;
sensors.values.add(sensor_depth);

var hdng = new M!Value;
hdng.name = "hdng";
hdng.type = svec;
sensors.values.add(hdng);

var obs = new M!Value;
obs.name = "obs";
obs.type = obstacle;
sensors.values.add(obs);

var close = new M!CompositeType;
close.name = "Close";
module.types.add(close);

var horiz_cda = new M!Value;
horiz_cda.name = "horiz_cda";
horiz_cda.type = realType;
close.values.add(horiz_cda);

var vert_cda = new M!Value;
vert_cda.name = "vert_cda";
vert_cda.type = realType;
close.values.add(vert_cda);

var close_id = new M!Value;
close_id.name = "id";
close_id.type = natType;
close.values.add(close_id);

var endTask = new M!Event;
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
reqVel.returnType = realType;
intpus.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
reqHdng.returnType = realType;
intpus.events.add(reqHdng);

var advVel = new M!Event;
advVel.name = "advVel";
var advVelParam = new M!Parameter;
advVelParam.name = "value";
advVelParam.type = realType;
advVel.parameters.add(advVelParam);
outputs.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";
var advHdngParam = new M!Parameter;
advHdngParam.name = "value";
advHdngParam.type = realType;
advHdng.parameters.add(advHdngParam);
outputs.events.add(advHdng);

var odist = new M!Function;
odist.name = "odist";
var odistParam = new M!Parameter;
odistParam.name = "obstacle";
odistParam.type = obstacle;
odist.parameters.add(odistParam);
odist.returnType = realType;
module.functions.add(odist);

var hdist = new M!Function;
hdist.name = "hdist";
var hdistParam = new M!Parameter;
hdistParam.name = "obstacle";
hdistParam.type = obstacle;
hdist.parameters.add(hdistParam);
hdist.returnType = realType;
module.functions.add(hdist);

var vdist = new M!Function;
vdist.name = "vdist";
var vdistParam = new M!Parameter;
vdistParam.name = "obstacle";
vdistParam.type = obstacle;
vdist.parameters.add(vdistParam);
vdist.returnType = realType;
module.functions.add(vdist);

var platform_f1 = new M!RoboticPlatform;
platform_f1.name = "Platform-F1";
module.platforms.add(platform_f1);

var platform_f2 = new M!RoboticPlatform;
platform_f2.name = "Platform-F2";
module.platforms.add(platform_f2);

var interface1 = new M!Interface;
interface1.name = "Interface1";
module.interfaces.add(interface1);

var interface3 = new M!Interface;
interface3.name = "Interface3";
module.interfaces.add(interface3);

var ct2 = new M!CompositeType;
ct2.name = "CT2";
module.types.add(ct2);

var cf3 = new M!Function;
cf3.name = "CF3";
cf3.returnType = realType;
module.functions.add(cf3);

platform_f1.usedInterfaces.add(interface1);
platform_f1.usedInterfaces.add(interface3);
platform_f2.usedInterfaces.add(interface3);

var ct2_value1 = new M!Value;
ct2_value1.name = "ct2_value1";
ct2_value1.type = ct2;
interface1.values.add(ct2_value1);

var ct2_value2 = new M!Value;
ct2_value2.name = "ct2_value2";
ct2_value2.type = ct2;
interface3.values.add(ct2_value2);

var cf3_parameter = new M!Parameter;
cf3_parameter.name = "param";
cf3_parameter.type = ct2;
cf3.parameters.add(cf3_parameter);
