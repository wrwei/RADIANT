var auvModule = new M!Module;
auvModule.name = "AUV_Module";

var natType = new M!PrimitiveType;
natType.name = "nat";
auvModule.primitiveTypes.add(natType);

var intType = new M!PrimitiveType;
intType.name = "int";
auvModule.primitiveTypes.add(intType);

var stringType = new M!PrimitiveType;
stringType.name = "string";
auvModule.primitiveTypes.add(stringType);

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";
auvModule.primitiveTypes.add(booleanType);

var realType = new M!PrimitiveType;
realType.name = "real";
auvModule.primitiveTypes.add(realType);

var svecType = new M!CompositeType;
svecType.name = "SVec";

var radial = new M!Value;
radial.name = "radial";
radial.type = realType;
svecType.values.add(radial);

var polar = new M!Value;
polar.name = "polar";
polar.type = realType;
svecType.values.add(polar);

var azimuth = new M!Value;
azimuth.name = "azimuth";
azimuth.type = realType;
svecType.values.add(azimuth);

auvModule.compositeTypes.add(svecType);

var obstacleType = new M!CompositeType;
obstacleType.name = "Obstacle";

var obsNsRelDist = new M!Value;
obsNsRelDist.name = "ns_rel_dist";
obsNsRelDist.type = realType;
obstacleType.values.add(obsNsRelDist);

var obsEwRelDist = new M!Value;
obsEwRelDist.name = "ew_rel_dist";
obsEwRelDist.type = realType;
obstacleType.values.add(obsEwRelDist);

var obsDepth = new M!Value;
obsDepth.name = "depth";
obsDepth.type = realType;
obstacleType.values.add(obsDepth);

var obsId = new M!Value;
obsId.name = "id";
obsId.type = realType;
obstacleType.values.add(obsId);

var obsHdng = new M!Value;
obsHdng.name = "obs_hdng";
obsHdng.type = svecType;
obstacleType.values.add(obsHdng);

auvModule.compositeTypes.add(obstacleType);

var closeType = new M!CompositeType;
closeType.name = "Close";

var closeHorizCda = new M!Value;
closeHorizCda.name = "horiz_cda";
closeHorizCda.type = realType;
closeType.values.add(closeHorizCda);

var closeVertCda = new M!Value;
closeVertCda.name = "vert_cda";
closeVertCda.type = realType;
closeType.values.add(closeVertCda);

var closeId = new M!Value;
closeId.name = "id";
closeId.type = natType;
closeType.values.add(closeId);

auvModule.compositeTypes.add(closeType);

var sensorsInterface = new M!Interface;
sensorsInterface.name = "Sensors";

var sensorDepth = new M!Value;
sensorDepth.name = "depth";
sensorDepth.type = realType;
sensorsInterface.values.add(sensorDepth);

var sensorHdng = new M!Value;
sensorHdng.name = "hdng";
sensorHdng.type = svecType;
sensorsInterface.values.add(sensorHdng);

var sensorObs = new M!Value;
sensorObs.name = "obs";
sensorObs.type = obstacleType;
sensorsInterface.values.add(sensorObs);

auvModule.interfaces.add(sensorsInterface);

var actuatorsInterface = new M!Interface;
actuatorsInterface.name = "Actuators";
auvModule.interfaces.add(actuatorsInterface);

var inputsInterface = new M!Interface;
inputsInterface.name = "Inputs";

var endTask = new M!Event;
endTask.name = "endTask";
inputsInterface.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
inputsInterface.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
inputsInterface.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
inputsInterface.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
reqVel.returnType = realType;
inputsInterface.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
reqHdng.returnType = realType;
inputsInterface.events.add(reqHdng);

auvModule.interfaces.add(inputsInterface);

var outputsInterface = new M!Interface;
outputsInterface.name = "Outputs";

var advVel = new M!Event;
advVel.name = "advVel";
var advVelParam = new M!Parameter;
advVelParam.name = "param";
advVelParam.type = realType;
advVel.parameters.add(advVelParam);
outputsInterface.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";
var advHdngParam = new M!Parameter;
advHdngParam.name = "param";
advHdngParam.type = realType;
advHdng.parameters.add(advHdngParam);
outputsInterface.events.add(advHdng);

auvModule.interfaces.add(outputsInterface);

var auvPlatform = new M!RoboticPlatform;
auvPlatform.name = "AUV_Platform";
auvPlatform.uses.add(sensorsInterface);
auvPlatform.uses.add(actuatorsInterface);
auvModule.platforms.add(auvPlatform);

var auvOperator = new M!Controller;
auvOperator.name = "AUV_Operator";
auvOperator.uses.add(inputsInterface);
auvModule.controllers.add(auvOperator);

var lreCtrl = new M!Controller;
lreCtrl.name = "LRE_Ctrl";
lreCtrl.uses.add(inputsInterface);
lreCtrl.uses.add(outputsInterface);
auvModule.controllers.add(lreCtrl);

var auvAutopilot = new M!Controller;
auvAutopilot.name = "AUV_Autopilot";
auvAutopilot.uses.add(outputsInterface);
auvModule.controllers.add(auvAutopilot);

var odist = new M!Function;
odist.name = "odist";
var odistParam = new M!Parameter;
odistParam.name = "obstacle";
odistParam.type = obstacleType;
odist.parameters.add(odistParam);
odist.returnType = realType;
auvModule.functions.add(odist);

var hdist = new M!Function;
hdist.name = "hdist";
var hdistParam = new M!Parameter;
hdistParam.name = "obstacle";
hdistParam.type = obstacleType;
hdist.parameters.add(hdistParam);
hdist.returnType = realType;
auvModule.functions.add(hdist);

var vdist = new M!Function;
vdist.name = "vdist";
var vdistParam = new M!Parameter;
vdistParam.name = "obstacle";
vdistParam.type = obstacleType;
vdist.parameters.add(vdistParam);
vdist.returnType = realType;
auvModule.functions.add(vdist);
