var auv_module = new M!Module();
auv_module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform();
auv_platform.name = "AUV_Platform";
auv_module.robotic_platforms.add(auv_platform);

var nat_type = new M!PrimitiveType();
nat_type.name = "nat";

var int_type = new M!PrimitiveType();
int_type.name = "int";

var string_type = new M!PrimitiveType();
string_type.name = "string";

var boolean_type = new M!PrimitiveType();
boolean_type.name = "boolean";

var real_type = new M!PrimitiveType();
real_type.name = "real";

var svec = new M!CompositeType();
svec.name = "SVec";

var radial = new M!Value();
radial.name = "radial";
radial.type = real_type;
svec.values.add(radial);

var polar = new M!Value();
polar.name = "polar";
polar.type = real_type;
svec.values.add(polar);

var azimuth = new M!Value();
azimuth.name = "azimuth";
azimuth.type = real_type;
svec.values.add(azimuth);

var obstacle = new M!CompositeType();
obstacle.name = "Obstacle";

var ns_rel_dist = new M!Value();
ns_rel_dist.name = "ns_rel_dist";
ns_rel_dist.type = real_type;
obstacle.values.add(ns_rel_dist);

var ew_rel_dist = new M!Value();
ew_rel_dist.name = "ew_rel_dist";
ew_rel_dist.type = real_type;
obstacle.values.add(ew_rel_dist);

var obstacle_depth = new M!Value();
obstacle_depth.name = "depth";
obstacle_depth.type = real_type;
obstacle.values.add(obstacle_depth);

var obstacle_id = new M!Value();
obstacle_id.name = "id";
obstacle_id.type = real_type;
obstacle.values.add(obstacle_id);

var obs_hdng = new M!Value();
obs_hdng.name = "obs_hdng";
obs_hdng.compositeType = svec;
obstacle.values.add(obs_hdng);

var close_type = new M!CompositeType();
close_type.name = "Close";

var horiz_cda = new M!Value();
horiz_cda.name = "horiz_cda";
horiz_cda.type = real_type;
close_type.values.add(horiz_cda);

var vert_cda = new M!Value();
vert_cda.name = "vert_cda";
vert_cda.type = real_type;
close_type.values.add(vert_cda);

var close_id = new M!Value();
close_id.name = "id";
close_id.type = nat_type;
close_type.values.add(close_id);

var sensors = new M!Interface();
sensors.name = "Sensors";

var sensors_depth = new M!Value();
sensors_depth.name = "depth";
sensors_depth.type = real_type;
sensors.values.add(sensors_depth);

var sensors_hdng = new M!Value();
sensors_hdng.name = "hdng";
sensors_hdng.compositeType = svec;
sensors.values.add(sensors_hdng);

var sensors_obs = new M!Value();
sensors_obs.name = "obs";
sensors_obs.compositeType = obstacle;
sensors.values.add(sensors_obs);

var actuators = new M!Interface();
actuators.name = "Actuators";

var inputs = new M!Interface();
inputs.name = "Inputs";

var intpus = new M!Interface();
intpus.name = "Intpus";

var endTask = new M!Event();
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event();
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event();
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event();
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event();
reqVel.name = "reqVel";
reqVel.returnType = real_type;
intpus.events.add(reqVel);

var reqHdng = new M!Event();
reqHdng.name = "reqHdng";
reqHdng.returnType = real_type;
intpus.events.add(reqHdng);

var outputs = new M!Interface();
outputs.name = "Outputs";

var advVel = new M!Event();
advVel.name = "advVel";

var advVel_param = new M!Value();
advVel_param.name = "value";
advVel_param.type = real_type;
advVel.parameters.add(advVel_param);
outputs.events.add(advVel);

var advHdng = new M!Event();
advHdng.name = "advHdng";

var advHdng_param = new M!Value();
advHdng_param.name = "value";
advHdng_param.type = real_type;
advHdng.parameters.add(advHdng_param);
outputs.events.add(advHdng);

auv_module.interfaces.add(sensors);
auv_module.interfaces.add(actuators);
auv_module.interfaces.add(inputs);
auv_module.interfaces.add(intpus);
auv_module.interfaces.add(outputs);

var auv_operator = new M!Controller();
auv_operator.name = "AUV_Operator";
auv_operator.interfaces.add(inputs);
auv_module.controllers.add(auv_operator);

var lre_ctrl = new M!Controller();
lre_ctrl.name = "LRE_Ctrl";
lre_ctrl.interfaces.add(inputs);
lre_ctrl.interfaces.add(outputs);
auv_module.controllers.add(lre_ctrl);

var auv_autopilot = new M!Controller();
auv_autopilot.name = "AUV_Autopilot";
auv_autopilot.interfaces.add(outputs);
auv_module.controllers.add(auv_autopilot);

var odist = new M!Function();
odist.name = "odist";
odist.returnType = real_type;

var odist_param = new M!Value();
odist_param.name = "obstacle";
odist_param.compositeType = obstacle;
odist.parameters.add(odist_param);

var hdist = new M!Function();
hdist.name = "hdist";
hdist.returnType = real_type;

var hdist_param = new M!Value();
hdist_param.name = "obstacle";
hdist_param.compositeType = obstacle;
hdist.parameters.add(hdist_param);

var vdist = new M!Function();
vdist.name = "vdist";
vdist.returnType = real_type;

var vdist_param = new M!Value();
vdist_param.name = "obstacle";
vdist_param.compositeType = obstacle;
vdist.parameters.add(vdist_param);
