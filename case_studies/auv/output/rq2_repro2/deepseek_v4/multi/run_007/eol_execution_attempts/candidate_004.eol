var auv_module = new M!Module();
auv_module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform();
auv_platform.name = "AUV_Platform";
auv_module.robotic_platforms.add(auv_platform);

var nat = new M!PrimitiveType();
nat.name = "nat";
var intType = new M!PrimitiveType();
intType.name = "int";
var stringType = new M!PrimitiveType();
stringType.name = "string";
var booleanType = new M!PrimitiveType();
booleanType.name = "boolean";
var realType = new M!PrimitiveType();
realType.name = "real";

var svec = new M!CompositeType();
svec.name = "SVec";
var radial = new M!Value();
radial.eSet("name", "radial");
radial.eSet("type", realType);
var polar = new M!Value();
polar.eSet("name", "polar");
polar.eSet("type", realType);
var azimuth = new M!Value();
azimuth.eSet("name", "azimuth");
azimuth.eSet("type", realType);
svec.values.add(radial);
svec.values.add(polar);
svec.values.add(azimuth);

var obstacle = new M!CompositeType();
obstacle.name = "Obstacle";
var ns_rel_dist = new M!Value();
ns_rel_dist.eSet("name", "ns_rel_dist");
ns_rel_dist.eSet("type", realType);
var ew_rel_dist = new M!Value();
ew_rel_dist.eSet("name", "ew_rel_dist");
ew_rel_dist.eSet("type", realType);
var depth_obstacle = new M!Value();
depth_obstacle.eSet("name", "depth");
depth_obstacle.eSet("type", realType);
var id_obstacle = new M!Value();
id_obstacle.eSet("name", "id");
id_obstacle.eSet("type", realType);
var obs_hdng = new M!Value();
obs_hdng.eSet("name", "obs_hdng");
obs_hdng.eSet("compositeType", svec);
obstacle.values.add(ns_rel_dist);
obstacle.values.add(ew_rel_dist);
obstacle.values.add(depth_obstacle);
obstacle.values.add(id_obstacle);
obstacle.values.add(obs_hdng);

var close = new M!CompositeType();
close.name = "Close";
var horiz_cda = new M!Value();
horiz_cda.eSet("name", "horiz_cda");
horiz_cda.eSet("type", realType);
var vert_cda = new M!Value();
vert_cda.eSet("name", "vert_cda");
vert_cda.eSet("type", realType);
var id_close = new M!Value();
id_close.eSet("name", "id");
id_close.eSet("type", nat);
close.values.add(horiz_cda);
close.values.add(vert_cda);
close.values.add(id_close);

var sensors = new M!Interface();
sensors.name = "Sensors";
var depth_sensor = new M!Value();
depth_sensor.eSet("name", "depth");
depth_sensor.eSet("type", realType);
var hdng_sensor = new M!Value();
hdng_sensor.eSet("name", "hdng");
hdng_sensor.eSet("compositeType", svec);
var obs_sensor = new M!Value();
obs_sensor.eSet("name", "obs");
obs_sensor.eSet("compositeType", obstacle);
sensors.values.add(depth_sensor);
sensors.values.add(hdng_sensor);
sensors.values.add(obs_sensor);
auv_module.interfaces.add(sensors);

var actuators = new M!Interface();
actuators.name = "Actuators";
auv_module.interfaces.add(actuators);

var inputs = new M!Interface();
inputs.name = "Inputs";

var endTask = new M!Event();
endTask.eSet("name", "endTask");
inputs.events.add(endTask);

var reqOCM = new M!Event();
reqOCM.eSet("name", "reqOCM");
inputs.events.add(reqOCM);

var reqMOM = new M!Event();
reqMOM.eSet("name", "reqMOM");
inputs.events.add(reqMOM);

var reqHCM = new M!Event();
reqHCM.eSet("name", "reqHCM");
inputs.events.add(reqHCM);

var reqVel = new M!Event();
reqVel.eSet("name", "reqVel");
reqVel.eSet("returnType", realType);
inputs.events.add(reqVel);

var reqHdng = new M!Event();
reqHdng.eSet("name", "reqHdng");
reqHdng.eSet("returnType", realType);
inputs.events.add(reqHdng);

auv_module.interfaces.add(inputs);

var outputs = new M!Interface();
outputs.name = "Outputs";

var advVel = new M!Event();
advVel.eSet("name", "advVel");
var advVelParam = new M!Value();
advVelParam.eSet("name", "param");
advVelParam.eSet("type", realType);
advVel.eSet("parameters", Sequence { advVelParam });
outputs.events.add(advVel);

var advHdng = new M!Event();
advHdng.eSet("name", "advHdng");
var advHdngParam = new M!Value();
advHdngParam.eSet("name", "param");
advHdngParam.eSet("type", realType);
advHdng.eSet("parameters", Sequence { advHdngParam });
outputs.events.add(advHdng);

auv_module.interfaces.add(outputs);

var intpus = new M!Interface();
intpus.name = "Intpus";

var endTaskIntpus = new M!Event();
endTaskIntpus.eSet("name", "endTask");
intpus.events.add(endTaskIntpus);

var reqOCMIntpus = new M!Event();
reqOCMIntpus.eSet("name", "reqOCM");
intpus.events.add(reqOCMIntpus);

var reqMOMIntpus = new M!Event();
reqMOMIntpus.eSet("name", "reqMOM");
intpus.events.add(reqMOMIntpus);

var reqHCMIntpus = new M!Event();
reqHCMIntpus.eSet("name", "reqHCM");
intpus.events.add(reqHCMIntpus);

var reqVelIntpus = new M!Event();
reqVelIntpus.eSet("name", "reqVel");
reqVelIntpus.eSet("returnType", realType);
intpus.events.add(reqVelIntpus);

var reqHdngIntpus = new M!Event();
reqHdngIntpus.eSet("name", "reqHdng");
reqHdngIntpus.eSet("returnType", realType);
intpus.events.add(reqHdngIntpus);

auv_module.interfaces.add(intpus);

var auv_operator = new M!Controller();
auv_operator.name = "AUV_Operator";
auv_operator.interfaces.add(inputs);
auv_module.controllers.add(auv_operator);

var lre_ctrl = new M!Controller();
lre_ctrl.name = "LRE_Ctrl";
lre_ctrl.interfaces.add(inputs);
lre_ctrl.interfaces.add(outputs);
auv_module.controllers.add(lre_ctrl);

var auv_autopilot = new M!Controller();
auv_autopilot.name = "AUV_Autopilot";
auv_autopilot.interfaces.add(outputs);
auv_module.controllers.add(auv_autopilot);

var odist = new M!Function();
odist.eSet("name", "odist");
odist.eSet("returnType", realType);
var odistParam = new M!Value();
odistParam.eSet("name", "obs");
odistParam.eSet("compositeType", obstacle);
odist.eSet("parameters", Sequence { odistParam });

var hdist = new M!Function();
hdist.eSet("name", "hdist");
hdist.eSet("returnType", realType);
var hdistParam = new M!Value();
hdistParam.eSet("name", "obs");
hdistParam.eSet("compositeType", obstacle);
hdist.eSet("parameters", Sequence { hdistParam });

var vdist = new M!Function();
vdist.eSet("name", "vdist");
vdist.eSet("returnType", realType);
var vdistParam = new M!Value();
vdistParam.eSet("name", "obs");
vdistParam.eSet("compositeType", obstacle);
vdist.eSet("parameters", Sequence { vdistParam });
