var m = new M!Module;
m.name = "AUV_Module";

var t_nat = new M!PrimitiveType;
t_nat.name = "nat";
m.primitiveTypes.add(t_nat);

var t_int = new M!PrimitiveType;
t_int.name = "int";
m.primitiveTypes.add(t_int);

var t_string = new M!PrimitiveType;
t_string.name = "string";
m.primitiveTypes.add(t_string);

var t_boolean = new M!PrimitiveType;
t_boolean.name = "boolean";
m.primitiveTypes.add(t_boolean);

var t_real = new M!PrimitiveType;
t_real.name = "real";
m.primitiveTypes.add(t_real);

var svec = new M!CompositeType;
svec.name = "SVec";
m.compositeTypes.add(svec);

var radial = new M!Value;
radial.name = "radial";
radial.type = t_real;
svec.values.add(radial);

var polar = new M!Value;
polar.name = "polar";
polar.type = t_real;
svec.values.add(polar);

var azimuth = new M!Value;
azimuth.name = "azimuth";
azimuth.type = t_real;
svec.values.add(azimuth);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";
m.compositeTypes.add(obstacle);

var ns_rel_dist = new M!Value;
ns_rel_dist.name = "ns_rel_dist";
ns_rel_dist.type = t_real;
obstacle.values.add(ns_rel_dist);

var ew_rel_dist = new M!Value;
ew_rel_dist.name = "ew_rel_dist";
ew_rel_dist.type = t_real;
obstacle.values.add(ew_rel_dist);

var depth_obstacle = new M!Value;
depth_obstacle.name = "depth";
depth_obstacle.type = t_real;
obstacle.values.add(depth_obstacle);

var id_obstacle = new M!Value;
id_obstacle.name = "id";
id_obstacle.type = t_real;
obstacle.values.add(id_obstacle);

var obs_hdng = new M!Value;
obs_hdng.name = "obs_hdng";
obs_hdng.type = svec;
obstacle.values.add(obs_hdng);

var close = new M!CompositeType;
close.name = "Close";
m.compositeTypes.add(close);

var horiz_cda = new M!Value;
horiz_cda.name = "horiz_cda";
horiz_cda.type = t_real;
close.values.add(horiz_cda);

var vert_cda = new M!Value;
vert_cda.name = "vert_cda";
vert_cda.type = t_real;
close.values.add(vert_cda);

var id_close = new M!Value;
id_close.name = "id";
id_close.type = t_nat;
close.values.add(id_close);

var sensors = new M!Interface;
sensors.name = "Sensors";
m.interfaces.add(sensors);

var depth_sensors = new M!Value;
depth_sensors.name = "depth";
depth_sensors.type = t_real;
sensors.values.add(depth_sensors);

var hdng = new M!Value;
hdng.name = "hdng";
hdng.type = svec;
sensors.values.add(hdng);

var obs = new M!Value;
obs.name = "obs";
obs.type = obstacle;
sensors.values.add(obs);

var inputs = new M!Interface;
inputs.name = "Inputs";
m.interfaces.add(inputs);

var intpus = new M!Interface;
intpus.name = "Intpus";
m.interfaces.add(intpus);

var endTask = new M!Event;
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
var rv_reqVel = new M!ReturnValue;
rv_reqVel.name = "return";
rv_reqVel.type = t_real;
reqVel.returnValue = rv_reqVel;
intpus.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
var rv_reqHdng = new M!ReturnValue;
rv_reqHdng.name = "return";
rv_reqHdng.type = t_real;
reqHdng.returnValue = rv_reqHdng;
intpus.events.add(reqHdng);

var outputs = new M!Interface;
outputs.name = "Outputs";
m.interfaces.add(outputs);

var advVel = new M!Event;
advVel.name = "advVel";
var p_advVel = new M!Parameter;
p_advVel.name = "param";
p_advVel.type = t_real;
advVel.parameters.add(p_advVel);
outputs.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";
var p_advHdng = new M!Parameter;
p_advHdng.name = "param";
p_advHdng.type = t_real;
advHdng.parameters.add(p_advHdng);
outputs.events.add(advHdng);

var actuators = new M!Interface;
actuators.name = "Actuators";
m.interfaces.add(actuators);

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";
m.platforms.add(auv_platform);
auv_platform.interfaces.add(sensors);
auv_platform.interfaces.add(actuators);

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";
m.controllers.add(auv_operator);
auv_operator.interfaces.add(inputs);

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";
m.controllers.add(lre_ctrl);
lre_ctrl.interfaces.add(inputs);
lre_ctrl.interfaces.add(outputs);

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";
m.controllers.add(auv_autopilot);
auv_autopilot.interfaces.add(outputs);

var odist = new M!Function;
odist.name = "odist";
var p_odist = new M!Parameter;
p_odist.name = "obstacle";
p_odist.type = obstacle;
odist.parameters.add(p_odist);
var rv_odist = new M!ReturnValue;
rv_odist.name = "return";
rv_odist.type = t_real;
odist.returnValue = rv_odist;
m.functions.add(odist);

var hdist = new M!Function;
hdist.name = "hdist";
var p_hdist = new M!Parameter;
p_hdist.name = "obstacle";
p_hdist.type = obstacle;
hdist.parameters.add(p_hdist);
var rv_hdist = new M!ReturnValue;
rv_hdist.name = "return";
rv_hdist.type = t_real;
hdist.returnValue = rv_hdist;
m.functions.add(hdist);

var vdist = new M!Function;
vdist.name = "vdist";
var p_vdist = new M!Parameter;
p_vdist.name = "obstacle";
p_vdist.type = obstacle;
vdist.parameters.add(p_vdist);
var rv_vdist = new M!ReturnValue;
rv_vdist.name = "return";
rv_vdist.type = t_real;
vdist.returnValue = rv_vdist;
m.functions.add(vdist);