package auv;

@namespace(uri="http://auv/1.0", prefix="auv")
package auv;

abstract class NamedElement {
    attr String name;
}

class Module extends NamedElement {
    val RoboticPlatform[*] platforms;
    val Controller[*] controllers;
    val Interface[*] interfaces;
    val PrimitiveType[*] primitiveTypes;
    val CompositeType[*] compositeTypes;
    val Function[*] functions;
}

class RoboticPlatform extends NamedElement {
    ref Interface[*] usedInterfaces;
}

abstract class Controller extends NamedElement {
    ref Interface[*] usedInterfaces;
}

class AUV_Operator extends Controller {
}

class LRE_Ctrl extends Controller {
}

class AUV_Autopilot extends Controller {
}

abstract class Interface extends NamedElement {
    val Value[*] values;
    val Event[*] events;
}

class Sensors extends Interface {
}

class Inputs extends Interface {
}

class Outputs extends Interface {
}

class Actuators extends Interface {
}

abstract class PrimitiveType extends NamedElement {
}

class nat extends PrimitiveType {
}

class int extends PrimitiveType {
}

class string extends PrimitiveType {
}

class boolean extends PrimitiveType {
}

class real extends PrimitiveType {
}

abstract class CompositeType extends NamedElement {
    val Value[*] fields;
}

class SVec extends CompositeType {
}

class Obstacle extends CompositeType {
}

class Close extends CompositeType {
}

class Value extends NamedElement {
    attr String type;
}

abstract class Event extends NamedElement {
    val Parameter[*] parameters;
    attr String returnType;
}

class endTask extends Event {
}

class reqOCM extends Event {
}

class reqMOM extends Event {
}

class reqHCM extends Event {
}

class reqVel extends Event {
}

class reqHdng extends Event {
}

class advVel extends Event {
}

class advHdng extends Event {
}

class Parameter extends NamedElement {
    attr String type;
}

abstract class Function extends NamedElement {
    attr String inputType;
    attr String returnType;
}

class odist extends Function {
}

class hdist extends Function {
}

class vdist extends Function {
}