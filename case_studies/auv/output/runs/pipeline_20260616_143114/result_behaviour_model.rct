diagram LRE_Beh

enumeration Close { Close_v0 Close_v1 }
enumeration Obstacle { Obstacle_v0 Obstacle_v1 }

interface Inputs {
}

interface Outputs {
}

interface LRE_Beh_State {
	var x : real
	var hvel : real
	var vvel : real
	var cdyn : nat
	var cstc : nat
	var inOPEZ : boolean
	var cda : real
	var tcpa : real
}

interface Constants {
	const MinSafeDist : real = 1
	const StaticObsHorizDist : real = 1
	const StaticObsDfltVertDist : real = 1
	const StaticObsVertDist : real = 1
}

stm LRE_Beh {
	uses Inputs uses Outputs requires LRE_Beh_State requires Constants
	state MOM {
		entry do { x := 1 }
	}
	state OCM {
	}
	state CAM {
	}
	state HCM {
		entry do { x := 1 }
	}
	initial i0
	transition t0 {
		from i0
		to OCM
	}
	transition t1 {
		from OCM
		to OCM
		trigger 
	}
	transition t2 {
		from OCM
		to OCM
		trigger 
	}
	transition t3 {
		from OCM
		to MOM
		trigger 
		condition hvel < 1 /\ vvel < 1 /\ UNKNOWN ( cdyn ) > 8 /\ UNKNOWN ( cstc ) > 1 /\ not ( inOPEZ )
	}
	transition t4 {
		from MOM
		to OCM
		condition inOPEZ
	}
	transition t5 {
		from MOM
		to OCM
		trigger 
	}
	transition t6 {
		from MOM
		to OCM
		trigger 
		action do x := 0
	}
	transition t7 {
		from MOM
		to CAM
		condition cda < MinSafeDist /\ tcpa >= 0
	}
	transition t8 {
		from MOM
		to HCM
		condition hvel >= 1 /\ UNKNOWN ( cstc ) < StaticObsHorizDist
	}
	transition t9 {
		from MOM
		to HCM
		condition UNKNOWN ( cstc ) <= StaticObsDfltVertDist
	}
	transition t10 {
		from MOM
		to HCM
		condition vvel >= 1 /\ UNKNOWN ( cstc ) < StaticObsVertDist
	}
	transition t11 {
		from MOM
		to HCM
		trigger 
	}
	transition t12 {
		from HCM
		to MOM
		condition UNKNOWN ( cstc ) > StaticObsHorizDist /\ UNKNOWN ( cstc ) > StaticObsVertDist
	}
	transition t13 {
		from HCM
		to CAM
		condition cda < MinSafeDist /\ tcpa >= 0
	}
	transition t14 {
		from HCM
		to OCM
		trigger 
	}
	transition t15 {
		from HCM
		to OCM
		condition inOPEZ
	}
	transition t16 {
		from CAM
		to OCM
		trigger 
	}
	transition t17 {
		from CAM
		to OCM
		condition cda >= MinSafeDist
	}
}

controller LRE_Beh_Ctrl {
	uses Inputs uses Outputs requires LRE_Beh_State requires Constants
	sref stm_ref0 = LRE_Beh
}

module LRE_Beh_Module {
	robotic platform LRE_Beh_Platform {
		provides Constants
	}
	cref ctrl_ref0 = LRE_Beh_Ctrl
}
