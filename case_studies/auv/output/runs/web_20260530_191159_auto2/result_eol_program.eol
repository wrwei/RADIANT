var auvModule = M!Module.allInstances.selectOne(m|m.name = 'AUV_Module');
if (auvModule.isUndefined()) {
    auvModule = new M!Module;
    auvModule.name = 'AUV_Module';
}

var sensorsI = M!Interface.allInstances.selectOne(i|i.name = 'Sensors');
if (sensorsI.isUndefined()) {
    sensorsI = new M!Interface;
    sensorsI.name = 'Sensors';
    auvModule.interfaces.add(sensorsI);
}
var actuatorsI = M!Interface.allInstances.selectOne(i|i.name = 'Actuators');
if (actuatorsI.isUndefined()) {
    actuatorsI = new M!Interface;
    actuatorsI.name = 'Actuators';
    auvModule.interfaces.add(actuatorsI);
}
var inputsI = M!Interface.allInstances.selectOne(i|i.name = 'Inputs');
if (inputsI.isUndefined()) {
    inputsI = new M!Interface;
    inputsI.name = 'Inputs';
    auvModule.interfaces.add(inputsI);
}
var outputsI = M!Interface.allInstances.selectOne(i|i.name = 'Outputs');
if (outputsI.isUndefined()) {
    outputsI = new M!Interface;
    outputsI.name = 'Outputs';
    auvModule.interfaces.add(outputsI);
}
var intpusI = M!Interface.allInstances.selectOne(i|i.name = 'Intpus');
if (intpusI.isUndefined()) {
    intpusI = new M!Interface;
    intpusI.name = 'Intpus';
    auvModule.interfaces.add(intpusI);
}

var auvPlatform = M!RoboticPlatform.allInstances.selectOne(p|p.name = 'AUV_Platform');
if (auvPlatform.isUndefined()) {
    auvPlatform = new M!RoboticPlatform;
    auvPlatform.name = 'AUV_Platform';
    auvModule.roboticPlatform.add(auvPlatform);
}
if (not auvPlatform.usedInterfaces.includes(sensorsI)) {
    auvPlatform.usedInterfaces.add(sensorsI);
}
if (not auvPlatform.usedInterfaces.includes(actuatorsI)) {
    auvPlatform.usedInterfaces.add(actuatorsI);
}

var auvOperator = M!Controller.allInstances.selectOne(c|c.name = 'AUV_Operator');
if (auvOperator.isUndefined()) {
    auvOperator = new M!Controller;
    auvOperator.name = 'AUV_Operator';
    auvModule.controllers.add(auvOperator);
}
if (not auvOperator.usedInterfaces.includes(inputsI)) {
    auvOperator.usedInterfaces.add(inputsI);
}

var lreCtrl = M!Controller.allInstances.selectOne(c|c.name = 'LRE_Ctrl');
if (lreCtrl.isUndefined()) {
    lreCtrl = new M!Controller;
    lreCtrl.name = 'LRE_Ctrl';
    auvModule.controllers.add(lreCtrl);
}
if (not lreCtrl.usedInterfaces.includes(inputsI)) {
    lreCtrl.usedInterfaces.add(inputsI);
}
if (not lreCtrl.usedInterfaces.includes(outputsI)) {
    lreCtrl.usedInterfaces.add(outputsI);
}

var auvAutopilot = M!Controller.allInstances.selectOne(c|c.name = 'AUV_Autopilot');
if (auvAutopilot.isUndefined()) {
    auvAutopilot = new M!Controller;
    auvAutopilot.name = 'AUV_Autopilot';
    auvModule.controllers.add(auvAutopilot);
}
if (not auvAutopilot.usedInterfaces.includes(outputsI)) {
    auvAutopilot.usedInterfaces.add(outputsI);
}

