var auv_module = new M!Module;
auv_module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";
auv_module.robotic_platforms.add(auv_platform);

var sensors = new M!Interface;
sensors.name = "Sensors";
auv_module.interfaces.add(sensors);

var actuators = new M!Interface;
actuators.name = "Actuators";
auv_module.interfaces.add(actuators);

var inputs = new M!Interface;
inputs.name = "Inputs";
auv_module.interfaces.add(inputs);

var intpus = new M!Interface;
intpus.name = "Intpus";
auv_module.interfaces.add(intpus);

var outputs = new M!Interface;
outputs.name = "Outputs";
auv_module.interfaces.add(outputs);

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";
auv_operator.interfaces.add(inputs);
auv_module.controllers.add(auv_operator);

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";
lre_ctrl.interfaces.add(inputs);
lre_ctrl.interfaces.add(outputs);
auv_module.controllers.add(lre_ctrl);

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";
auv_autopilot.interfaces.add(outputs);
auv_module.controllers.add(auv_autopilot);

var natType = new M!PrimitiveType;
natType.name = "nat";

var intType = new M!PrimitiveType;
intType.name = "int";

var stringType = new M!PrimitiveType;
stringType.name = "string";

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";

var realType = new M!PrimitiveType;
realType.name = "real";

var svec = new M!CompositeType;
svec.name = "SVec";

var svec_radial = new M!Value;
svec_radial.name = "radial";
svec_radial.type = realType;
svec.values.add(svec_radial);

var svec_polar = new M!Value;
svec_polar.name = "polar";
svec_polar.type = realType;
svec.values.add(svec_polar);

var svec_azimuth = new M!Value;
svec_azimuth.name = "azimuth";
svec_azimuth.type = realType;
svec.values.add(svec_azimuth);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";

var obstacle_ns_rel_dist = new M!Value;
obstacle_ns_rel_dist.name = "ns_rel_dist";
obstacle_ns_rel_dist.type = realType;
obstacle.values.add(obstacle_ns_rel_dist);

var obstacle_ew_rel_dist = new M!Value;
obstacle_ew_rel_dist.name = "ew_rel_dist";
obstacle_ew_rel_dist.type = realType;
obstacle.values.add(obstacle_ew_rel_dist);

var obstacle_depth = new M!Value;
obstacle_depth.name = "depth";
obstacle_depth.type = realType;
obstacle.values.add(obstacle_depth);

var obstacle_id = new M!Value;
obstacle_id.name = "id";
obstacle_id.type = realType;
obstacle.values.add(obstacle_id);

var obstacle_obs_hdng = new M!Value;
obstacle_obs_hdng.name = "obs_hdng";
obstacle_obs_hdng.compositeType = svec;
obstacle.values.add(obstacle_obs_hdng);

var close = new M!CompositeType;
close.name = "Close";

var close_horiz_cda = new M!Value;
close_horiz_cda.name = "horiz_cda";
close_horiz_cda.type = realType;
close.values.add(close_horiz_cda);

var close_vert_cda = new M!Value;
close_vert_cda.name = "vert_cda";
close_vert_cda.type = realType;
close.values.add(close_vert_cda);

var close_id = new M!Value;
close_id.name = "id";
close_id.type = natType;
close.values.add(close_id);

var sensor_depth = new M!Value;
sensor_depth.name = "depth";
sensor_depth.type = realType;
sensors.values.add(sensor_depth);

var sensor_hdng = new M!Value;
sensor_hdng.name = "hdng";
sensor_hdng.compositeType = svec;
sensors.values.add(sensor_hdng);

var sensor_obs = new M!Value;
sensor_obs.name = "obs";
sensor_obs.compositeType = obstacle;
sensors.values.add(sensor_obs);

var endTask = new M!Event;
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
reqVel.returnType = realType;
intpus.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
reqHdng.returnType = realType;
intpus.events.add(reqHdng);

var advVel = new M!Event;
advVel.name = "advVel";

var advVel_parameter = new M!Value;
advVel_parameter.name = "parameter";
advVel_parameter.type = realType;
advVel.parameters.add(advVel_parameter);
outputs.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";

var advHdng_parameter = new M!Value;
advHdng_parameter.name = "parameter";
advHdng_parameter.type = realType;
advHdng.parameters.add(advHdng_parameter);
outputs.events.add(advHdng);

var odist = new M!Function;
odist.name = "odist";

var odist_parameter = new M!Value;
odist_parameter.name = "obstacle";
odist_parameter.compositeType = obstacle;
odist.parameters.add(odist_parameter);
odist.returnType = realType;

var hdist = new M!Function;
hdist.name = "hdist";

var hdist_parameter = new M!Value;
hdist_parameter.name = "obstacle";
hdist_parameter.compositeType = obstacle;
hdist.parameters.add(hdist_parameter);
hdist.returnType = realType;

var vdist = new M!Function;
vdist.name = "vdist";

var vdist_parameter = new M!Value;
vdist_parameter.name = "obstacle";
vdist_parameter.compositeType = obstacle;
vdist.parameters.add(vdist_parameter);
vdist.returnType = realType;