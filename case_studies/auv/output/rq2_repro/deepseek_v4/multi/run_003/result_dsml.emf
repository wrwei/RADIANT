package auv;

abstract class NamedElement {
    attr String name;
}

abstract class Type extends NamedElement {}

abstract class TypedElement extends NamedElement {
    ref Type[1] type;
}

abstract class Callable extends NamedElement {
    val Parameter[*] parameters;
}

abstract class ValueContainer {
    val Value[*] values;
}

class Module extends NamedElement {
    val RoboticPlatform[*] platforms;
    val Controller[*] controllers;
    val Interface[*] interfaces;
    val PrimitiveType[*] primitiveTypes;
    val CompositeType[*] compositeTypes;
    val Function[*] functions;
}

class RoboticPlatform extends NamedElement {
    ref Interface[1] sensors;
    ref Interface[1] actuators;
}

class Controller extends NamedElement {
    ref Interface[*] usedInterfaces;
}

class Interface extends NamedElement, ValueContainer {
    val Event[*] events;
}

class PrimitiveType extends Type {}

class CompositeType extends Type, ValueContainer {
}

class Value extends TypedElement {
}

class Event extends Callable {
    ref Type[0..1] returnType;
}

class Parameter extends TypedElement {
}

class Function extends Callable {
    ref Type[1] returnType;
}