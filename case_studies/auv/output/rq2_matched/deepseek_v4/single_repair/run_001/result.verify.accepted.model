<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:model="http://generated/model">
  <model:Module name="AUV_Module">
    <controllers name="AUV_Operator"/>
    <controllers name="LRE_Ctrl"/>
    <controllers name="AUV_Autopilot"/>
    <interfaces name="Sensors">
      <values name="depth" type="/6"/>
      <values name="hdng" type="/7"/>
      <values name="obs" type="/8"/>
    </interfaces>
    <interfaces name="Actuators"/>
    <interfaces name="Inputs"/>
    <interfaces name="Outputs">
      <events name="advVel">
        <parameters xsi:type="model:Value" name="param" type="/6"/>
      </events>
      <events name="advHdng">
        <parameters xsi:type="model:Value" name="param" type="/6"/>
      </events>
    </interfaces>
    <interfaces name="Intpus">
      <events name="endTask"/>
      <events name="reqOCM"/>
      <events name="reqMOM"/>
      <events name="reqHCM"/>
      <events name="reqVel" returnType="/6"/>
      <events name="reqHdng" returnType="/6"/>
    </interfaces>
  </model:Module>
  <model:RoboticPlatform name="AUV_Platform"/>
  <model:PrimitiveType name="nat"/>
  <model:PrimitiveType name="int"/>
  <model:PrimitiveType name="string"/>
  <model:PrimitiveType name="boolean"/>
  <model:PrimitiveType name="real"/>
  <model:CompositeType name="SVec">
    <values name="radial" type="/6"/>
    <values name="polar" type="/6"/>
    <values name="azimuth" type="/6"/>
  </model:CompositeType>
  <model:CompositeType name="Obstacle">
    <values name="ns_rel_dist" type="/6"/>
    <values name="ew_rel_dist" type="/6"/>
    <values name="depth" type="/6"/>
    <values name="id" type="/6"/>
    <values name="obs_hdng" type="/7"/>
  </model:CompositeType>
  <model:CompositeType name="Close">
    <values name="horiz_cda" type="/6"/>
    <values name="vert_cda" type="/6"/>
    <values name="id" type="/2"/>
  </model:CompositeType>
  <model:Function name="odist" returnType="/6">
    <parameters xsi:type="model:Value" name="obstacle" type="/8"/>
  </model:Function>
  <model:Function name="hdist" returnType="/6">
    <parameters xsi:type="model:Value" name="obstacle" type="/8"/>
  </model:Function>
  <model:Function name="vdist" returnType="/6">
    <parameters xsi:type="model:Value" name="obstacle" type="/8"/>
  </model:Function>
</xmi:XMI>
