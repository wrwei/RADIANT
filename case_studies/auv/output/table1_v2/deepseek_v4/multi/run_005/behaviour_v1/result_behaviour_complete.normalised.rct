I will output exactly the candidate.stm LRE_Beh {
	event reqVel
	event reqHdng
	event reqMOM
	event reqOCM
	event endTask
	event reqHCM
	event advVel
	event advHdng
	var inOPEZ : boolean
	var collisionRisk : boolean
	var staticObstacleNear : boolean
	var velocityHigh : boolean
	initial i0
	state OCM { }
	state MOM { entry advVel }
	state CAM { }
	state HCM { entry advVel }
	transition t0 { from i0 to OCM }
	transition t1 { from OCM to OCM trigger reqVel action advVel }
	transition t2 { from OCM to OCM trigger reqHdng action advHdng }
	transition t3 { from OCM to MOM trigger reqMOM condition not velocityHigh /\ not collisionRisk /\ not staticObstacleNear /\ not inOPEZ }
	transition t4 { from MOM to OCM condition inOPEZ }
	transition t5 { from MOM to OCM trigger reqOCM }
	transition t6 { from MOM to OCM trigger endTask action advVel }
	transition t7 { from MOM to CAM condition collisionRisk }
	transition t8 { from MOM to HCM condition staticObstacleNear }
	transition t9 { from MOM to HCM condition velocityHigh /\ staticObstacleNear }
	transition t10 { from MOM to HCM trigger reqHCM }
	transition t11 { from HCM to MOM condition not staticObstacleNear }
	transition t12 { from HCM to CAM condition collisionRisk }
	transition t13 { from HCM to OCM trigger reqOCM }
	transition t14 { from HCM to OCM condition inOPEZ }
	transition t15 { from CAM to OCM trigger reqOCM }
	transition t16 { from CAM to OCM condition not collisionRisk }
}