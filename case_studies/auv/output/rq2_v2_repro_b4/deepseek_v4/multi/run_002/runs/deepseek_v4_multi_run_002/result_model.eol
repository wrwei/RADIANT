var auv_module = new M!Module;
auv_module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";

var sensors = new M!Interface;
sensors.name = "Sensors";

var actuators = new M!Interface;
actuators.name = "Actuators";

var inputs = new M!Interface;
inputs.name = "Inputs";

var intpus = new M!Interface;
intpus.name = "Intpus";

var outputs = new M!Interface;
outputs.name = "Outputs";

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";

var natType = new M!PrimitiveType;
natType.name = "nat";

var intType = new M!PrimitiveType;
intType.name = "int";

var stringType = new M!PrimitiveType;
stringType.name = "string";

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";

var realType = new M!PrimitiveType;
realType.name = "real";

auv_module.platforms.add(auv_platform);

auv_module.controllers.add(auv_operator);
auv_module.controllers.add(lre_ctrl);
auv_module.controllers.add(auv_autopilot);

auv_module.interfaces.add(sensors);
auv_module.interfaces.add(actuators);
auv_module.interfaces.add(inputs);
auv_module.interfaces.add(intpus);
auv_module.interfaces.add(outputs);

auv_module.primitiveTypes.add(natType);
auv_module.primitiveTypes.add(intType);
auv_module.primitiveTypes.add(stringType);
auv_module.primitiveTypes.add(booleanType);
auv_module.primitiveTypes.add(realType);

auv_platform.interfaces.add(sensors);
auv_platform.interfaces.add(actuators);

auv_operator.interfaces.add(inputs);

lre_ctrl.interfaces.add(inputs);
lre_ctrl.interfaces.add(outputs);

auv_autopilot.interfaces.add(outputs);

var svec = new M!CompositeType;
svec.name = "SVec";

var radial = new M!Value;
radial.name = "radial";
radial.type = realType;

var polar = new M!Value;
polar.name = "polar";
polar.type = realType;

var azimuth = new M!Value;
azimuth.name = "azimuth";
azimuth.type = realType;

svec.values.add(radial);
svec.values.add(polar);
svec.values.add(azimuth);
auv_module.compositeTypes.add(svec);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";

var ns_rel_dist = new M!Value;
ns_rel_dist.name = "ns_rel_dist";
ns_rel_dist.type = realType;

var ew_rel_dist = new M!Value;
ew_rel_dist.name = "ew_rel_dist";
ew_rel_dist.type = realType;

var obstacle_depth = new M!Value;
obstacle_depth.name = "depth";
obstacle_depth.type = realType;

var obstacle_id = new M!Value;
obstacle_id.name = "id";
obstacle_id.type = realType;

var obs_hdng = new M!Value;
obs_hdng.name = "obs_hdng";
obs_hdng.type = svec;

obstacle.values.add(ns_rel_dist);
obstacle.values.add(ew_rel_dist);
obstacle.values.add(obstacle_depth);
obstacle.values.add(obstacle_id);
obstacle.values.add(obs_hdng);
auv_module.compositeTypes.add(obstacle);

var closeComposite = new M!CompositeType;
closeComposite.name = "Close";

var horiz_cda = new M!Value;
horiz_cda.name = "horiz_cda";
horiz_cda.type = realType;

var vert_cda = new M!Value;
vert_cda.name = "vert_cda";
vert_cda.type = realType;

var close_id = new M!Value;
close_id.name = "id";
close_id.type = natType;

closeComposite.values.add(horiz_cda);
closeComposite.values.add(vert_cda);
closeComposite.values.add(close_id);
auv_module.compositeTypes.add(closeComposite);

var sensor_depth = new M!Value;
sensor_depth.name = "depth";
sensor_depth.type = realType;

var sensor_hdng = new M!Value;
sensor_hdng.name = "hdng";
sensor_hdng.type = svec;

var sensor_obs = new M!Value;
sensor_obs.name = "obs";
sensor_obs.type = obstacle;

sensors.values.add(sensor_depth);
sensors.values.add(sensor_hdng);
sensors.values.add(sensor_obs);

var endTask = new M!Event;
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
var reqVel_return = new M!ReturnValue;
reqVel_return.name = "return";
reqVel_return.type = realType;
reqVel.returnValue = reqVel_return;
intpus.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
var reqHdng_return = new M!ReturnValue;
reqHdng_return.name = "return";
reqHdng_return.type = realType;
reqHdng.returnValue = reqHdng_return;
intpus.events.add(reqHdng);

var advVel = new M!Event;
advVel.name = "advVel";
var advVel_param = new M!Parameter;
advVel_param.name = "param";
advVel_param.type = realType;
advVel.parameters.add(advVel_param);
outputs.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";
var advHdng_param = new M!Parameter;
advHdng_param.name = "param";
advHdng_param.type = realType;
advHdng.parameters.add(advHdng_param);
outputs.events.add(advHdng);

var odist = new M!Function;
odist.name = "odist";
var odist_param = new M!Parameter;
odist_param.name = "obstacle";
odist_param.type = obstacle;
odist.parameters.add(odist_param);
var odist_return = new M!ReturnValue;
odist_return.name = "return";
odist_return.type = realType;
odist.returnValue = odist_return;
auv_module.functions.add(odist);

var hdist = new M!Function;
hdist.name = "hdist";
var hdist_param = new M!Parameter;
hdist_param.name = "obstacle";
hdist_param.type = obstacle;
hdist.parameters.add(hdist_param);
var hdist_return = new M!ReturnValue;
hdist_return.name = "return";
hdist_return.type = realType;
hdist.returnValue = hdist_return;
auv_module.functions.add(hdist);

var vdist = new M!Function;
vdist.name = "vdist";
var vdist_param = new M!Parameter;
vdist_param.name = "obstacle";
vdist_param.type = obstacle;
vdist.parameters.add(vdist_param);
var vdist_return = new M!ReturnValue;
vdist_return.name = "return";
vdist_return.type = realType;
vdist.returnValue = vdist_return;
auv_module.functions.add(vdist);
