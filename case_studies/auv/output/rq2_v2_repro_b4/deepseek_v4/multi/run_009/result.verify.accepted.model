<?xml version="1.0" encoding="ASCII"?>
<auv:Module xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:auv="http://www.example.org/auv" name="AUV_Module">
  <platforms name="AUV_Platform" interfaces="//@interfaces.0 //@interfaces.3"/>
  <controllers name="AUV_Operator" interfaces="//@interfaces.1"/>
  <controllers name="LRE_Ctrl" interfaces="//@interfaces.1 //@interfaces.2"/>
  <controllers name="AUV_Autopilot" interfaces="//@interfaces.2"/>
  <interfaces name="Sensors">
    <values name="depth" type="//@primitiveTypes.4"/>
    <values name="hdng" type="//@primitiveTypes.5"/>
    <values name="obs" type="//@primitiveTypes.6"/>
  </interfaces>
  <interfaces name="Inputs">
    <events name="endTask"/>
    <events name="reqOCM"/>
    <events name="reqMOM"/>
    <events name="reqHCM"/>
    <events name="reqVel">
      <returnValue name="return" type="//@primitiveTypes.4"/>
    </events>
    <events name="reqHdng">
      <returnValue name="return" type="//@primitiveTypes.4"/>
    </events>
  </interfaces>
  <interfaces name="Outputs">
    <events name="advVel">
      <parameters name="vel" type="//@primitiveTypes.4"/>
    </events>
    <events name="advHdng">
      <parameters name="hdng" type="//@primitiveTypes.4"/>
    </events>
  </interfaces>
  <interfaces name="Actuators"/>
  <primitiveTypes name="nat"/>
  <primitiveTypes name="int"/>
  <primitiveTypes name="string"/>
  <primitiveTypes name="boolean"/>
  <primitiveTypes name="real"/>
  <primitiveTypes name="SVec"/>
  <primitiveTypes name="Obstacle"/>
  <compositeTypes name="SVec">
    <values name="radial" type="//@primitiveTypes.4"/>
    <values name="polar" type="//@primitiveTypes.4"/>
    <values name="azimuth" type="//@primitiveTypes.4"/>
  </compositeTypes>
  <compositeTypes name="Obstacle">
    <values name="ns_rel_dist" type="//@primitiveTypes.4"/>
    <values name="ew_rel_dist" type="//@primitiveTypes.4"/>
    <values name="depth" type="//@primitiveTypes.4"/>
    <values name="id" type="//@primitiveTypes.4"/>
    <values name="obs_hdng" type="//@primitiveTypes.5"/>
  </compositeTypes>
  <compositeTypes name="Close">
    <values name="horiz_cda" type="//@primitiveTypes.4"/>
    <values name="vert_cda" type="//@primitiveTypes.4"/>
    <values name="id" type="//@primitiveTypes.0"/>
  </compositeTypes>
  <functions name="odist">
    <parameters name="obstacle" type="//@primitiveTypes.6"/>
    <returnValue name="distance" type="//@primitiveTypes.4"/>
  </functions>
  <functions name="hdist">
    <parameters name="obstacle" type="//@primitiveTypes.6"/>
    <returnValue name="distance" type="//@primitiveTypes.4"/>
  </functions>
  <functions name="vdist">
    <parameters name="obstacle" type="//@primitiveTypes.6"/>
    <returnValue name="distance" type="//@primitiveTypes.4"/>
  </functions>
</auv:Module>
