stm LRE_Beh {
	event reqVel
	event reqHdng
	event reqMOM
	event reqHCM
	event reqOCM
	event endTask
	event advVel
	event advHdng
	var inOPEZ : boolean
	var collisionRisk : boolean
	var staticObstacleNear : boolean
	var velocityHigh : boolean
	initial i0
	state OCM { }
	state MOM { entry advVel }
	state CAM { }
	state HCM { entry advVel }
	transition t_init { from i0 to OCM }
	transition t_ocm_reqVel { from OCM to OCM trigger reqVel action advVel }
	transition t_ocm_reqHdng { from OCM to OCM trigger reqHdng action advHdng }
	transition t_ocm_to_mom { from OCM to MOM trigger reqMOM condition not velocityHigh /\ not collisionRisk /\ not staticObstacleNear /\ not inOPEZ }
	transition t_mom_to_ocm_opz { from MOM to OCM condition inOPEZ }
	transition t_mom_to_ocm_reqOCM { from MOM to OCM trigger reqOCM }
	transition t_mom_to_ocm_endTask { from MOM to OCM trigger endTask action advVel }
	transition t_mom_to_cam { from MOM to CAM condition collisionRisk }
	transition t_mom_to_hcm_high_static { from MOM to HCM condition velocityHigh /\ staticObstacleNear }
	transition t_mom_to_hcm_static { from MOM to HCM condition staticObstacleNear }
	transition t_mom_to_hcm_reqHCM { from MOM to HCM trigger reqHCM }
	transition t_hcm_to_mom { from HCM to MOM condition not staticObstacleNear }
	transition t_hcm_to_cam { from HCM to CAM condition collisionRisk }
	transition t_hcm_to_ocm_reqOCM { from HCM to OCM trigger reqOCM }
	transition t_hcm_to_ocm_opz { from HCM to OCM condition inOPEZ }
	transition t_cam_to_ocm_reqOCM { from CAM to OCM trigger reqOCM }
	transition t_cam_to_ocm_clear { from CAM to OCM condition not collisionRisk }
}