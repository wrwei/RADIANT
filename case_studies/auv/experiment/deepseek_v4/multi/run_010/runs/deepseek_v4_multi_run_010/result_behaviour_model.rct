stm LRE_Beh {
	event reqVel
	event reqHdng
	event reqMOM
	event reqOCM
	event endTask
	event reqHCM
	event advVel
	event advHdng
	var inOPEZ : boolean
	var collisionRisk : boolean
	var staticObstacleNear : boolean
	var velocityHigh : boolean
	initial i0
	state OCM {
	}
	state MOM {
		entry advVel
	}
	state CAM {
	}
	state HCM {
		entry advVel
	}
	transition t0 { from i0 to OCM }
	transition t_beh2 { from OCM to OCM trigger reqVel action advVel }
	transition t_beh3 { from OCM to OCM trigger reqHdng action advHdng }
	transition t_beh4 { from OCM to MOM trigger reqMOM condition not velocityHigh /\ not collisionRisk /\ not staticObstacleNear /\ not inOPEZ }
	transition t_beh5 { from MOM to OCM condition inOPEZ }
	transition t_beh6 { from MOM to OCM trigger reqOCM }
	transition t_beh7 { from MOM to OCM trigger endTask action advVel }
	transition t_beh8 { from MOM to CAM condition collisionRisk }
	transition t_beh9 { from MOM to HCM condition velocityHigh /\ staticObstacleNear }
	transition t_beh10 { from MOM to HCM condition staticObstacleNear }
	transition t_beh11 { from MOM to HCM condition velocityHigh /\ staticObstacleNear }
	transition t_beh12 { from MOM to HCM trigger reqHCM }
	transition t_beh13 { from HCM to MOM condition not staticObstacleNear }
	transition t_beh14 { from HCM to CAM condition collisionRisk }
	transition t_beh15 { from HCM to OCM trigger reqOCM }
	transition t_beh16 { from HCM to OCM condition inOPEZ }
	transition t_beh17 { from CAM to OCM trigger reqOCM }
	transition t_beh18 { from CAM to OCM condition not collisionRisk }
}