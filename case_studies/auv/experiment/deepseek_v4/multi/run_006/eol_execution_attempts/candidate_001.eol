var auvModule = new M!Module;
auvModule.name = "AUV_Module";

var auvPlatform = new M!RoboticPlatform;
auvPlatform.name = "AUV_Platform";
auvModule.platforms.add(auvPlatform);

var sensors = new M!Interface;
sensors.name = "Sensors";
auvModule.interfaces.add(sensors);

var actuators = new M!Interface;
actuators.name = "Actuators";
auvModule.interfaces.add(actuators);

auvPlatform.usedInterfaces.add(sensors);
auvPlatform.usedInterfaces.add(actuators);

var auvOperator = new M!Controller;
auvOperator.name = "AUV_Operator";
auvModule.controllers.add(auvOperator);

var intpus = new M!Interface;
intpus.name = "Intpus";
auvModule.interfaces.add(intpus);

auvOperator.usedInterfaces.add(intpus);

var lreCtrl = new M!Controller;
lreCtrl.name = "LRE_Ctrl";
auvModule.controllers.add(lreCtrl);

var outputs = new M!Interface;
outputs.name = "Outputs";
auvModule.interfaces.add(outputs);

lreCtrl.usedInterfaces.add(intpus);
lreCtrl.usedInterfaces.add(outputs);

var auvAutopilot = new M!Controller;
auvAutopilot.name = "AUV_Autopilot";
auvModule.controllers.add(auvAutopilot);

auvAutopilot.usedInterfaces.add(outputs);

var nat = new M!PrimitiveType;
nat.name = "nat";
auvModule.primitiveTypes.add(nat);

var int = new M!PrimitiveType;
int.name = "int";
auvModule.primitiveTypes.add(int);

var string = new M!PrimitiveType;
string.name = "string";
auvModule.primitiveTypes.add(string);

var boolean = new M!PrimitiveType;
boolean.name = "boolean";
auvModule.primitiveTypes.add(boolean);

var real = new M!PrimitiveType;
real.name = "real";
auvModule.primitiveTypes.add(real);

var svec = new M!CompositeType;
svec.name = "SVec";
auvModule.compositeTypes.add(svec);

var radial = new M!Value;
radial.name = "radial";
radial.type = real;
svec.values.add(radial);

var polar = new M!Value;
polar.name = "polar";
polar.type = real;
svec.values.add(polar);

var azimuth = new M!Value;
azimuth.name = "azimuth";
azimuth.type = real;
svec.values.add(azimuth);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";
auvModule.compositeTypes.add(obstacle);

var nsRelDist = new M!Value;
nsRelDist.name = "ns_rel_dist";
nsRelDist.type = real;
obstacle.values.add(nsRelDist);

var ewRelDist = new M!Value;
ewRelDist.name = "ew_rel_dist";
ewRelDist.type = real;
obstacle.values.add(ewRelDist);

var depth = new M!Value;
depth.name = "depth";
depth.type = real;
obstacle.values.add(depth);

var id = new M!Value;
id.name = "id";
id.type = real;
obstacle.values.add(id);

var obsHdng = new M!Value;
obsHdng.name = "obs_hdng";
obsHdng.type = svec;
obstacle.values.add(obsHdng);

var close = new M!CompositeType;
close.name = "Close";
auvModule.compositeTypes.add(close);

var horizCda = new M!Value;
horizCda.name = "horiz_cda";
horizCda.type = real;
close.values.add(horizCda);

var vertCda = new M!Value;
vertCda.name = "vert_cda";
vertCda.type = real;
close.values.add(vertCda);

var idClose = new M!Value;
idClose.name = "id";
idClose.type = nat;
close.values.add(idClose);

var sensorDepth = new M!Value;
sensorDepth.name = "depth";
sensorDepth.type = real;
sensors.values.add(sensorDepth);

var hdng = new M!Value;
hdng.name = "hdng";
hdng.type = svec;
sensors.values.add(hdng);

var obs = new M!Value;
obs.name = "obs";
obs.type = obstacle;
sensors.values.add(obs);

var endTask = new M!Event;
endTask.name = "endTask";
intpus.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpus.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpus.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpus.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
reqVel.returnType = real;
intpus.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
reqHdng.returnType = real;
intpus.events.add(reqHdng);

var paramAdvVel = new M!Parameter;
paramAdvVel.name = "param";
paramAdvVel.type = real;

var advVel = new M!Event;
advVel.name = "advVel";
advVel.parameters.add(paramAdvVel);
outputs.events.add(advVel);

var paramAdvHdng = new M!Parameter;
paramAdvHdng.name = "param";
paramAdvHdng.type = real;

var advHdng = new M!Event;
advHdng.name = "advHdng";
advHdng.parameters.add(paramAdvHdng);
outputs.events.add(advHdng);

var odist = new M!Function;
odist.name = "odist";
odist.returnType = real;
auvModule.functions.add(odist);

var odistParam = new M!Parameter;
odistParam.name = "obstacle";
odistParam.type = obstacle;
odist.parameters.add(odistParam);

var hdist = new M!Function;
hdist.name = "hdist";
hdist.returnType = real;
auvModule.functions.add(hdist);

var hdistParam = new M!Parameter;
hdistParam.name = "obstacle";
hdistParam.type = obstacle;
hdist.parameters.add(hdistParam);

var vdist = new M!Function;
vdist.name = "vdist";
vdist.returnType = real;
auvModule.functions.add(vdist);

var vdistParam = new M!Parameter;
vdistParam.name = "obstacle";
vdistParam.type = obstacle;
vdist.parameters.add(vdistParam);
