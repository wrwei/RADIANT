enumeration Mode { idle active }

stm LRE_Beh {
	event reqVel
	event reqHdng
	event advVel
	event advHdng
	event reqMOM
	event reqOCM
	event endTask
	event reqHCM

	var inOPEZ : boolean
	var collisionRisk : boolean
	var staticObstacleNear : boolean
	var velocityHigh : boolean

	initial i0

	state OCM { }
	state MOM { entry advVel }
	state CAM { }
	state HCM { entry advVel }

	transition t_init { from i0 to OCM }

	transition t_ocm_vel { from OCM to OCM trigger reqVel action advVel }
	transition t_ocm_hdng { from OCM to OCM trigger reqHdng action advHdng }

	transition t_ocm_to_mom { from OCM to MOM trigger reqMOM condition not velocityHigh /\ not collisionRisk /\ not staticObstacleNear /\ not inOPEZ }

	transition t_mom_to_ocm_opez { from MOM to OCM condition inOPEZ }
	transition t_mom_to_ocm_req { from MOM to OCM trigger reqOCM }
	transition t_mom_to_ocm_end { from MOM to OCM trigger endTask action advVel }

	transition t_mom_to_cam { from MOM to CAM condition collisionRisk }

	transition t_mom_to_hcm_static { from MOM to HCM condition staticObstacleNear }
	transition t_mom_to_hcm_velstatic { from MOM to HCM condition velocityHigh /\ staticObstacleNear }
	transition t_mom_to_hcm_req { from MOM to HCM trigger reqHCM }

	transition t_hcm_to_mom { from HCM to MOM condition not staticObstacleNear }
	transition t_hcm_to_cam { from HCM to CAM condition collisionRisk }
	transition t_hcm_to_ocm_req { from HCM to OCM trigger reqOCM }
	transition t_hcm_to_ocm_opez { from HCM to OCM condition inOPEZ }

	transition t_cam_to_ocm_req { from CAM to OCM trigger reqOCM }
	transition t_cam_to_ocm_norisk { from CAM to OCM condition not collisionRisk }
}