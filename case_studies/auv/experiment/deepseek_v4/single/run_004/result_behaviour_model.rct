stm LRE_Beh {
	event reqVel
	event reqHdng
	event reqMOM
	event reqOCM
	event endTask
	event reqHCM
	event advVel
	event advHdng
	var inOPEZ : boolean
	var collisionRisk : boolean
	var staticObstacleNear : boolean
	var velocityHigh : boolean
	initial i0
	state OCM { }
	state MOM { entry advVel }
	state CAM { }
	state HCM { entry advVel }
	transition t0 { from i0 to OCM }
	transition t_ocm_reqVel { from OCM to OCM trigger reqVel action advVel }
	transition t_ocm_reqHdng { from OCM to OCM trigger reqHdng action advHdng }
	transition t_ocm_mom { from OCM to MOM trigger reqMOM condition not velocityHigh /\ not collisionRisk /\ not staticObstacleNear /\ not inOPEZ }
	transition t_mom_ocm_opez { from MOM to OCM condition inOPEZ }
	transition t_mom_ocm_req { from MOM to OCM trigger reqOCM }
	transition t_mom_ocm_end { from MOM to OCM trigger endTask action advVel }
	transition t_mom_cam { from MOM to CAM condition collisionRisk }
	transition t_mom_hcm_obs { from MOM to HCM condition staticObstacleNear }
	transition t_mom_hcm_req { from MOM to HCM trigger reqHCM }
	transition t_hcm_mom { from HCM to MOM condition not staticObstacleNear }
	transition t_hcm_cam { from HCM to CAM condition collisionRisk }
	transition t_hcm_ocm_req { from HCM to OCM trigger reqOCM }
	transition t_hcm_ocm_opez { from HCM to OCM condition inOPEZ }
	transition t_cam_ocm_req { from CAM to OCM trigger reqOCM }
	transition t_cam_ocm_cond { from CAM to OCM condition not collisionRisk }
}