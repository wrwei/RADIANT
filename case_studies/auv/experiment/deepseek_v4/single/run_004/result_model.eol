var auv_module = new M!Module;
auv_module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";
auv_module.platforms.add(auv_platform);

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";
auv_module.controllers.add(auv_operator);

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";
auv_module.controllers.add(lre_ctrl);

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";
auv_module.controllers.add(auv_autopilot);

var nat = new M!PrimitiveType;
nat.name = "nat";
auv_module.primitiveTypes.add(nat);

var intType = new M!PrimitiveType;
intType.name = "int";
auv_module.primitiveTypes.add(intType);

var stringType = new M!PrimitiveType;
stringType.name = "string";
auv_module.primitiveTypes.add(stringType);

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";
auv_module.primitiveTypes.add(booleanType);

var realType = new M!PrimitiveType;
realType.name = "real";
auv_module.primitiveTypes.add(realType);

var svec = new M!CompositeType;
svec.name = "SVec";
auv_module.compositeTypes.add(svec);

var radial_val = new M!Value;
radial_val.name = "radial";
radial_val.type = "real";
svec.values.add(radial_val);

var polar_val = new M!Value;
polar_val.name = "polar";
polar_val.type = "real";
svec.values.add(polar_val);

var azimuth_val = new M!Value;
azimuth_val.name = "azimuth";
azimuth_val.type = "real";
svec.values.add(azimuth_val);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";
auv_module.compositeTypes.add(obstacle);

var ns_rel_dist_val = new M!Value;
ns_rel_dist_val.name = "ns_rel_dist";
ns_rel_dist_val.type = "real";
obstacle.values.add(ns_rel_dist_val);

var ew_rel_dist_val = new M!Value;
ew_rel_dist_val.name = "ew_rel_dist";
ew_rel_dist_val.type = "real";
obstacle.values.add(ew_rel_dist_val);

var depth_val = new M!Value;
depth_val.name = "depth";
depth_val.type = "real";
obstacle.values.add(depth_val);

var id_val = new M!Value;
id_val.name = "id";
id_val.type = "real";
obstacle.values.add(id_val);

var obs_hdng_val = new M!Value;
obs_hdng_val.name = "obs_hdng";
obs_hdng_val.type = "SVec";
obstacle.values.add(obs_hdng_val);

var closeType = new M!CompositeType;
closeType.name = "Close";
auv_module.compositeTypes.add(closeType);

var horiz_cda_val = new M!Value;
horiz_cda_val.name = "horiz_cda";
horiz_cda_val.type = "real";
closeType.values.add(horiz_cda_val);

var vert_cda_val = new M!Value;
vert_cda_val.name = "vert_cda";
vert_cda_val.type = "real";
closeType.values.add(vert_cda_val);

var close_id_val = new M!Value;
close_id_val.name = "id";
close_id_val.type = "nat";
closeType.values.add(close_id_val);

var sensorsInterface = new M!Interface;
sensorsInterface.name = "Sensors";
auv_module.interfaces.add(sensorsInterface);

var depthSensVal = new M!Value;
depthSensVal.name = "depth";
depthSensVal.type = "real";
sensorsInterface.values.add(depthSensVal);

var hdngSensVal = new M!Value;
hdngSensVal.name = "hdng";
hdngSensVal.type = "SVec";
sensorsInterface.values.add(hdngSensVal);

var obsSensVal = new M!Value;
obsSensVal.name = "obs";
obsSensVal.type = "Obstacle";
sensorsInterface.values.add(obsSensVal);

var intpusInterface = new M!Interface;
intpusInterface.name = "Intpus";
auv_module.interfaces.add(intpusInterface);

var endTaskEvent = new M!Event;
endTaskEvent.name = "endTask";
endTaskEvent.returnType = "";
intpusInterface.events.add(endTaskEvent);

var reqOCMEvent = new M!Event;
reqOCMEvent.name = "reqOCM";
reqOCMEvent.returnType = "";
intpusInterface.events.add(reqOCMEvent);

var reqMOMEvent = new M!Event;
reqMOMEvent.name = "reqMOM";
reqMOMEvent.returnType = "";
intpusInterface.events.add(reqMOMEvent);

var reqHCMEvent = new M!Event;
reqHCMEvent.name = "reqHCM";
reqHCMEvent.returnType = "";
intpusInterface.events.add(reqHCMEvent);

var reqVelEvent = new M!Event;
reqVelEvent.name = "reqVel";
reqVelEvent.returnType = "real";
intpusInterface.events.add(reqVelEvent);

var reqHdngEvent = new M!Event;
reqHdngEvent.name = "reqHdng";
reqHdngEvent.returnType = "real";
intpusInterface.events.add(reqHdngEvent);

var outputsInterface = new M!Interface;
outputsInterface.name = "Outputs";
auv_module.interfaces.add(outputsInterface);

var advVelEvent = new M!Event;
advVelEvent.name = "advVel";
advVelEvent.returnType = "";
var advVelParam = new M!Parameter;
advVelParam.name = "param";
advVelParam.type = "real";
advVelEvent.parameters.add(advVelParam);
outputsInterface.events.add(advVelEvent);

var advHdngEvent = new M!Event;
advHdngEvent.name = "advHdng";
advHdngEvent.returnType = "";
var advHdngParam = new M!Parameter;
advHdngParam.name = "param";
advHdngParam.type = "real";
advHdngEvent.parameters.add(advHdngParam);
outputsInterface.events.add(advHdngEvent);

var actuatorsInterface = new M!Interface;
actuatorsInterface.name = "Actuators";
auv_module.interfaces.add(actuatorsInterface);

auv_platform.usedInterfaces.add(sensorsInterface);
auv_platform.usedInterfaces.add(actuatorsInterface);

auv_operator.usedInterfaces.add(intpusInterface);

lre_ctrl.usedInterfaces.add(intpusInterface);
lre_ctrl.usedInterfaces.add(outputsInterface);

auv_autopilot.usedInterfaces.add(outputsInterface);

var odistFunc = new M!Function;
odistFunc.name = "odist";
odistFunc.inputType = "Obstacle";
odistFunc.returnType = "real";
auv_module.functions.add(odistFunc);

var hdistFunc = new M!Function;
hdistFunc.name = "hdist";
hdistFunc.inputType = "Obstacle";
hdistFunc.returnType = "real";
auv_module.functions.add(hdistFunc);

var vdistFunc = new M!Function;
vdistFunc.name = "vdist";
vdistFunc.inputType = "Obstacle";
vdistFunc.returnType = "real";
auv_module.functions.add(vdistFunc);