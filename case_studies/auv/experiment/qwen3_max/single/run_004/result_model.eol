var auv_module = new M!Module;
auv_module.name = "AUV_Module";

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";
auv_module.platforms.add(auv_platform);

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";
auv_module.controllers.add(auv_operator);

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";
auv_module.controllers.add(lre_ctrl);

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";
auv_module.controllers.add(auv_autopilot);

var nat = new M!PrimitiveType;
nat.name = "nat";
auv_module.primitiveTypes.add(nat);

var int_type = new M!PrimitiveType;
int_type.name = "int";
auv_module.primitiveTypes.add(int_type);

var string_type = new M!PrimitiveType;
string_type.name = "string";
auv_module.primitiveTypes.add(string_type);

var boolean = new M!PrimitiveType;
boolean.name = "boolean";
auv_module.primitiveTypes.add(boolean);

var real = new M!PrimitiveType;
real.name = "real";
auv_module.primitiveTypes.add(real);

var svec = new M!CompositeType;
svec.name = "SVec";
auv_module.compositeTypes.add(svec);

var radial_field = new M!TypedField;
radial_field.name = "radial";
radial_field.type = real;
svec.fields.add(radial_field);

var polar_field = new M!TypedField;
polar_field.name = "polar";
polar_field.type = real;
svec.fields.add(polar_field);

var azimuth_field = new M!TypedField;
azimuth_field.name = "azimuth";
azimuth_field.type = real;
svec.fields.add(azimuth_field);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";
auv_module.compositeTypes.add(obstacle);

var ns_rel_dist_field = new M!TypedField;
ns_rel_dist_field.name = "ns_rel_dist";
ns_rel_dist_field.type = real;
obstacle.fields.add(ns_rel_dist_field);

var ew_rel_dist_field = new M!TypedField;
ew_rel_dist_field.name = "ew_rel_dist";
ew_rel_dist_field.type = real;
obstacle.fields.add(ew_rel_dist_field);

var depth_field = new M!TypedField;
depth_field.name = "depth";
depth_field.type = real;
obstacle.fields.add(depth_field);

var id_field_obstacle = new M!TypedField;
id_field_obstacle.name = "id";
id_field_obstacle.type = real;
obstacle.fields.add(id_field_obstacle);

var obs_hdng_field = new M!TypedField;
obs_hdng_field.name = "obs_hdng";
obs_hdng_field.type = svec;
obstacle.fields.add(obs_hdng_field);

var close = new M!CompositeType;
close.name = "Close";
auv_module.compositeTypes.add(close);

var horiz_cda_field = new M!TypedField;
horiz_cda_field.name = "horiz_cda";
horiz_cda_field.type = real;
close.fields.add(horiz_cda_field);

var vert_cda_field = new M!TypedField;
vert_cda_field.name = "vert_cda";
vert_cda_field.type = real;
close.fields.add(vert_cda_field);

var id_field_close = new M!TypedField;
id_field_close.name = "id";
id_field_close.type = nat;
close.fields.add(id_field_close);

var sensors = new M!Interface;
sensors.name = "Sensors";
auv_module.interfaces.add(sensors);

var hdng_value = new M!Value;
hdng_value.name = "hdng";
hdng_value.type = svec;
sensors.values.add(hdng_value);

var obs_value = new M!Value;
obs_value.name = "obs";
obs_value.type = obstacle;
sensors.values.add(obs_value);

var actuators = new M!Interface;
actuators.name = "Actuators";
auv_module.interfaces.add(actuators);

var inputs = new M!Interface;
inputs.name = "Inputs";
auv_module.interfaces.add(inputs);

var endTask_event = new M!Event;
endTask_event.name = "endTask";
inputs.events.add(endTask_event);

var reqOCM_event = new M!Event;
reqOCM_event.name = "reqOCM";
inputs.events.add(reqOCM_event);

var reqMOM_event = new M!Event;
reqMOM_event.name = "reqMOM";
inputs.events.add(reqMOM_event);

var reqHCM_event = new M!Event;
reqHCM_event.name = "reqHCM";
inputs.events.add(reqHCM_event);

var reqVel_event = new M!Event;
reqVel_event.name = "reqVel";
reqVel_event.returnType = real;
inputs.events.add(reqVel_event);

var reqHdng_event = new M!Event;
reqHdng_event.name = "reqHdng";
reqHdng_event.returnType = real;
inputs.events.add(reqHdng_event);

var outputs = new M!Interface;
outputs.name = "Outputs";
auv_module.interfaces.add(outputs);

var advVel_event = new M!Event;
advVel_event.name = "advVel";
var advVel_param = new M!Parameter;
advVel_param.name = "velocity";
advVel_param.type = real;
advVel_event.parameters.add(advVel_param);
outputs.events.add(advVel_event);

var advHdng_event = new M!Event;
advHdng_event.name = "advHdng";
var advHdng_param = new M!Parameter;
advHdng_param.name = "heading";
advHdng_param.type = real;
advHdng_event.parameters.add(advHdng_param);
outputs.events.add(advHdng_event);

auv_platform.usedInterfaces.add(sensors);
auv_platform.usedInterfaces.add(actuators);

auv_operator.usedInterfaces.add(inputs);

lre_ctrl.usedInterfaces.add(inputs);
lre_ctrl.usedInterfaces.add(outputs);

auv_autopilot.usedInterfaces.add(outputs);

var odist_func = new M!Function;
odist_func.name = "odist";
var odist_param = new M!Parameter;
odist_param.name = "obstacle";
odist_param.type = obstacle;
odist_func.parameters.add(odist_param);
odist_func.returnType = real;
auv_module.functions.add(odist_func);

var hdist_func = new M!Function;
hdist_func.name = "hdist";
var hdist_param = new M!Parameter;
hdist_param.name = "obstacle";
hdist_param.type = obstacle;
hdist_func.parameters.add(hdist_param);
hdist_func.returnType = real;
auv_module.functions.add(hdist_func);

var vdist_func = new M!Function;
vdist_func.name = "vdist";
var vdist_param = new M!Parameter;
vdist_param.name = "obstacle";
vdist_param.type = obstacle;
vdist_func.parameters.add(vdist_param);
vdist_func.returnType = real;
auv_module.functions.add(vdist_func);