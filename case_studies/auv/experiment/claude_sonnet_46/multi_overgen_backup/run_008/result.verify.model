<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:auv="http://auv/1.0">
  <auv:Module name="AUV_Module">
    <interfaces name="Sensors">
      <values name="depth"/>
      <values name="hdng"/>
      <values name="obs"/>
    </interfaces>
    <interfaces name="Actuators"/>
    <interfaces name="Intpus">
      <events name="endTask"/>
      <events name="reqOCM"/>
      <events name="reqMOM"/>
      <events name="reqHCM"/>
      <events name="reqVel"/>
      <events name="reqHdng"/>
    </interfaces>
    <interfaces name="Inputs"/>
    <interfaces name="Outputs">
      <events name="advVel">
        <parameters xsi:type="auv:Value" name="vel_param"/>
      </events>
      <events name="advHdng">
        <parameters xsi:type="auv:Value" name="hdng_param"/>
      </events>
    </interfaces>
    <primitiveTypes name="nat"/>
    <primitiveTypes name="int"/>
    <primitiveTypes name="string"/>
    <primitiveTypes name="boolean"/>
    <primitiveTypes name="real"/>
    <compositeTypes name="SVec">
      <values name="radial"/>
      <values name="polar"/>
      <values name="azimuth"/>
    </compositeTypes>
    <compositeTypes name="Obstacle">
      <values name="ns_rel_dist"/>
      <values name="ew_rel_dist"/>
      <values name="depth"/>
      <values name="id"/>
      <values name="obs_hdng"/>
    </compositeTypes>
    <compositeTypes name="Close">
      <values name="horiz_cda"/>
      <values name="vert_cda"/>
      <values name="id"/>
    </compositeTypes>
  </auv:Module>
  <auv:RoboticPlatform name="AUV_Platform"/>
</xmi:XMI>
