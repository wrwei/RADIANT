Looking at the failures, there are 5 unresolved trace entries. The issue is that several instance classes (`RoboticPlatformInstance`, `ControllerInstance`, `SensorInstance`, `ActuatorInstance`, `InterfaceInstance`) are defined but not contained anywhere in the model hierarchy (no parent class holds `val` references to them). Also, there should likely be a `System` or `Configuration` class that contains these instances, or they should be added to `Module`.

The most logical fix is to add a class (e.g., `SystemConfiguration`) that contains these instance classes, and add it to `Module`, making all instance classes reachable/contained in the model. Alternatively, adding the instance collections directly to `Module` resolves the containment issue.

@namespace(uri="http://auv/1.0", prefix="auv")
package auv;

abstract class NamedElement {
    attr String name;
}

class Module extends NamedElement {
    val RoboticPlatform[*] platforms;
    val Controller[*] controllers;
    val Interface[*] interfaces;
    val PrimitiveType[*] primitiveTypes;
    val CompositeType[*] compositeTypes;
    val Function[*] functions;
    val Sensor[*] sensors;
    val Actuator[*] actuators;
    val EnumerationType[*] enumerationTypes;
    val Action[*] actions;
    val RoboticPlatformInstance[*] roboticPlatformInstances;
    val ControllerInstance[*] controllerInstances;
    val SensorInstance[*] sensorInstances;
    val ActuatorInstance[*] actuatorInstances;
    val InterfaceInstance[*] interfaceInstances;
}

class RoboticPlatform extends NamedElement {
    ref Interface[*] usedInterfaces;
}

class Controller extends NamedElement {
    ref Interface[*] usedInterfaces;
}

class Interface extends NamedElement {
    val Value[*] values;
    val Event[*] events;
}

class PrimitiveType extends NamedElement {
}

class CompositeType extends NamedElement {
    val Value[*] values;
}

abstract class TypedElement extends NamedElement {
    ref NamedElement ~type;
}

class Value extends TypedElement {
}

class Parameter extends TypedElement {
}

abstract class CallableElement extends NamedElement {
    val Parameter[*] parameters;
    ref PrimitiveType returnType;
}

class Event extends CallableElement {
}

class Function extends CallableElement {
}

class Action extends CallableElement {
}

class Sensor extends NamedElement {
    ref Interface[*] providedInterfaces;
}

class Actuator extends NamedElement {
    ref Interface[*] providedInterfaces;
}

class EnumerationType extends NamedElement {
    val EnumerationLiteral[*] literals;
}

class EnumerationLiteral extends NamedElement {
}

class RoboticPlatformInstance extends NamedElement {
    ref RoboticPlatform platform;
}

class ControllerInstance extends NamedElement {
    ref Controller controller;
}

class SensorInstance extends NamedElement {
    ref Sensor sensor;
}

class ActuatorInstance extends NamedElement {
    ref Actuator actuator;
}

class InterfaceInstance extends NamedElement {
    ref Interface ~interface;
}
