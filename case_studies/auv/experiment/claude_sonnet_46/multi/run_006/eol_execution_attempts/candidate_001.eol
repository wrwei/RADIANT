var auv_module = new M!Module;
auv_module.name = "AUV_Module";

var nat = new M!PrimitiveType;
nat.name = "nat";
auv_module.primitiveTypes.add(nat);

var intType = new M!PrimitiveType;
intType.name = "int";
auv_module.primitiveTypes.add(intType);

var stringType = new M!PrimitiveType;
stringType.name = "string";
auv_module.primitiveTypes.add(stringType);

var booleanType = new M!PrimitiveType;
booleanType.name = "boolean";
auv_module.primitiveTypes.add(booleanType);

var real = new M!PrimitiveType;
real.name = "real";
auv_module.primitiveTypes.add(real);

var svec = new M!CompositeType;
svec.name = "SVec";

var radial = new M!TypedField;
radial.name = "radial";
radial.type = real;
svec.fields.add(radial);

var polar = new M!TypedField;
polar.name = "polar";
polar.type = real;
svec.fields.add(polar);

var azimuth = new M!TypedField;
azimuth.name = "azimuth";
azimuth.type = real;
svec.fields.add(azimuth);

auv_module.compositeTypes.add(svec);

var obstacle = new M!CompositeType;
obstacle.name = "Obstacle";

var ns_rel_dist = new M!TypedField;
ns_rel_dist.name = "ns_rel_dist";
ns_rel_dist.type = real;
obstacle.fields.add(ns_rel_dist);

var ew_rel_dist = new M!TypedField;
ew_rel_dist.name = "ew_rel_dist";
ew_rel_dist.type = real;
obstacle.fields.add(ew_rel_dist);

var obs_depth = new M!TypedField;
obs_depth.name = "depth";
obs_depth.type = real;
obstacle.fields.add(obs_depth);

var obs_id = new M!TypedField;
obs_id.name = "id";
obs_id.type = real;
obstacle.fields.add(obs_id);

var obs_hdng = new M!TypedField;
obs_hdng.name = "obs_hdng";
obs_hdng.type = svec;
obstacle.fields.add(obs_hdng);

auv_module.compositeTypes.add(obstacle);

var closeType = new M!CompositeType;
closeType.name = "Close";

var horiz_cda = new M!TypedField;
horiz_cda.name = "horiz_cda";
horiz_cda.type = real;
closeType.fields.add(horiz_cda);

var vert_cda = new M!TypedField;
vert_cda.name = "vert_cda";
vert_cda.type = real;
closeType.fields.add(vert_cda);

var close_id = new M!TypedField;
close_id.name = "id";
close_id.type = nat;
closeType.fields.add(close_id);

auv_module.compositeTypes.add(closeType);

var sensorsIface = new M!Interface;
sensorsIface.name = "Sensors";

var sens_depth = new M!Value;
sens_depth.name = "depth";
sens_depth.type = real;
sensorsIface.values.add(sens_depth);

var hdng = new M!Value;
hdng.name = "hdng";
hdng.type = svec;
sensorsIface.values.add(hdng);

var obs = new M!Value;
obs.name = "obs";
obs.type = obstacle;
sensorsIface.values.add(obs);

auv_module.interfaces.add(sensorsIface);

var actuatorsIface = new M!Interface;
actuatorsIface.name = "Actuators";
auv_module.interfaces.add(actuatorsIface);

var intpusIface = new M!Interface;
intpusIface.name = "Intpus";

var endTask = new M!Event;
endTask.name = "endTask";
intpusIface.events.add(endTask);

var reqOCM = new M!Event;
reqOCM.name = "reqOCM";
intpusIface.events.add(reqOCM);

var reqMOM = new M!Event;
reqMOM.name = "reqMOM";
intpusIface.events.add(reqMOM);

var reqHCM = new M!Event;
reqHCM.name = "reqHCM";
intpusIface.events.add(reqHCM);

var reqVel = new M!Event;
reqVel.name = "reqVel";
reqVel.returnType = real;
intpusIface.events.add(reqVel);

var reqHdng = new M!Event;
reqHdng.name = "reqHdng";
reqHdng.returnType = real;
intpusIface.events.add(reqHdng);

auv_module.interfaces.add(intpusIface);

var outputsIface = new M!Interface;
outputsIface.name = "Outputs";

var advVel = new M!Event;
advVel.name = "advVel";
var advVelParam = new M!Parameter;
advVelParam.name = "vel";
advVelParam.type = real;
advVel.parameters.add(advVelParam);
outputsIface.events.add(advVel);

var advHdng = new M!Event;
advHdng.name = "advHdng";
var advHdngParam = new M!Parameter;
advHdngParam.name = "hdng";
advHdngParam.type = real;
advHdng.parameters.add(advHdngParam);
outputsIface.events.add(advHdng);

auv_module.interfaces.add(outputsIface);

var inputsIface = new M!Interface;
inputsIface.name = "Inputs";
auv_module.interfaces.add(inputsIface);

var auv_platform = new M!RoboticPlatform;
auv_platform.name = "AUV_Platform";
auv_platform.usedInterfaces.add(sensorsIface);
auv_platform.usedInterfaces.add(actuatorsIface);
auv_module.platforms.add(auv_platform);

var auv_operator = new M!Controller;
auv_operator.name = "AUV_Operator";
auv_operator.usedInterfaces.add(inputsIface);
auv_module.controllers.add(auv_operator);

var lre_ctrl = new M!Controller;
lre_ctrl.name = "LRE_Ctrl";
lre_ctrl.usedInterfaces.add(inputsIface);
lre_ctrl.usedInterfaces.add(outputsIface);
auv_module.controllers.add(lre_ctrl);

var auv_autopilot = new M!Controller;
auv_autopilot.name = "AUV_Autopilot";
auv_autopilot.usedInterfaces.add(outputsIface);
auv_module.controllers.add(auv_autopilot);

var odist = new M!Function;
odist.name = "odist";
var odistParam = new M!Parameter;
odistParam.name = "obstacle";
odistParam.type = obstacle;
odist.parameters.add(odistParam);
odist.returnType = real;
auv_module.functions.add(odist);

var hdist = new M!Function;
hdist.name = "hdist";
var hdistParam = new M!Parameter;
hdistParam.name = "obstacle";
hdistParam.type = obstacle;
hdist.parameters.add(hdistParam);
hdist.returnType = real;
auv_module.functions.add(hdist);

var vdist = new M!Function;
vdist.name = "vdist";
var vdistParam = new M!Parameter;
vdistParam.name = "obstacle";
vdistParam.type = obstacle;
vdist.parameters.add(vdistParam);
vdist.returnType = real;
auv_module.functions.add(vdist);
