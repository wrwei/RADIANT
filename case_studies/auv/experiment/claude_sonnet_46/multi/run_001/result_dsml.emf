@namespace(uri="http://auv/1.0", prefix="auv")
package auv;

abstract class NamedElement {
    attr String name;
}

class Module extends NamedElement {
    val RoboticPlatform[*] platforms;
    val Controller[*] controllers;
    val Interface[*] interfaces;
    val PrimitiveType[*] primitiveTypes;
    val CompositeType[*] compositeTypes;
    val Function[*] functions;
}

class RoboticPlatform extends NamedElement {
    ref Interface[*] usedInterfaces;
}

class Controller extends NamedElement {
    ref Interface[*] usedInterfaces;
}

class Interface extends NamedElement {
    val Value[*] values;
    val Event[*] events;
}

abstract class TypeDefinition extends NamedElement {
}

class PrimitiveType extends TypeDefinition {
}

class CompositeType extends TypeDefinition {
    val Field[*] fields;
}

class Field extends NamedElement {
    ref TypeDefinition type;
}

class Value extends NamedElement {
    ref TypeDefinition type;
}

class Event extends NamedElement {
    val Parameter[*] parameters;
    ref TypeDefinition returnType;
}

class Parameter extends NamedElement {
    ref TypeDefinition type;
}

class Function extends NamedElement {
    val Parameter[*] inputs;
    ref TypeDefinition returnType;
}