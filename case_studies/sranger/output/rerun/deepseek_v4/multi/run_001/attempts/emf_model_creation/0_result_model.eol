var system = new M!System();
system.name = "SRanger";

var controller = new M!Controller();
controller.name = "controller";
system.controller = controller;

var sensor = new M!Sensor();
sensor.name = "sensor";
controller.sensor = sensor;

var actuator = new M!Actuator();
actuator.name = "actuator";
actuator.lastLinearVelocity = 0.0.asDouble();
actuator.lastAngularVelocity = 0.0.asDouble();
controller.actuator = actuator;

var stateMachine = new M!StateMachine();
stateMachine.name = "stateMachine";
controller.stateMachine = stateMachine;

var moving = new M!Mode();
moving.name = "Moving";
moving.initial = true;
moving.terminal = false;

var turning = new M!Mode();
turning.name = "Turning";
turning.initial = false;
turning.terminal = false;

var finalMode = new M!Mode();
finalMode.name = "Final";
finalMode.initial = false;
finalMode.terminal = true;

stateMachine.modes.add(moving);
stateMachine.modes.add(turning);
stateMachine.modes.add(finalMode);

var moveVel = new M!Constant();
moveVel.name = "moveVel";
moveVel.value = 1.0.asDouble();
moveVel.unit = "m/s";
controller.constants.add(moveVel);

var turnVel = new M!Constant();
turnVel.name = "turnVel";
turnVel.value = 2.0.asDouble();
turnVel.unit = "rad/s";
controller.constants.add(turnVel);

var obstacleThreshold = new M!Constant();
obstacleThreshold.name = "obstacleThreshold";
obstacleThreshold.value = 0.5.asDouble();
obstacleThreshold.unit = "m";
controller.constants.add(obstacleThreshold);

var turnDuration = new M!Constant();
turnDuration.name = "turnDuration";
turnDuration.value = 2.0.asDouble();
turnDuration.unit = "s";
controller.constants.add(turnDuration);

var clockResetTime = new M!Variable();
clockResetTime.name = "clockResetTime";
clockResetTime.type = "real";
clockResetTime.value = 0.0.asDouble();
controller.variables.add(clockResetTime);

var obstacle = new M!InputEvent();
obstacle.name = "obstacle";
controller.inputEvents.add(obstacle);

var tick = new M!InputEvent();
tick.name = "tick";
controller.inputEvents.add(tick);

var endTask = new M!InputEvent();
endTask.name = "endTask";
controller.inputEvents.add(endTask);

var move = new M!OutputEvent();
move.name = "Move";
move.linearVelocity = 0.0.asDouble();
move.angularVelocity = 0.0.asDouble();
controller.outputEvents.add(move);

var movingToTurning = new M!Transition();
movingToTurning.name = "MovingToTurning";
movingToTurning.source = moving;
movingToTurning.target = turning;
movingToTurning.trigger = obstacle;
movingToTurning.guard = "";
movingToTurning.action = "clockResetTime = currentTime; Move(0, turnVel)";
stateMachine.transitions.add(movingToTurning);

var turningToMoving = new M!Transition();
turningToMoving.name = "TurningToMoving";
turningToMoving.source = turning;
turningToMoving.target = moving;
turningToMoving.trigger = tick;
turningToMoving.guard = "elapsedTime >= turnDuration";
turningToMoving.action = "Move(moveVel, 0)";
stateMachine.transitions.add(turningToMoving);

var movingToFinal = new M!Transition();
movingToFinal.name = "MovingToFinal";
movingToFinal.source = moving;
movingToFinal.target = finalMode;
movingToFinal.trigger = endTask;
movingToFinal.guard = "";
movingToFinal.action = "Move(0, 0)";
stateMachine.transitions.add(movingToFinal);

var turningToFinal = new M!Transition();
turningToFinal.name = "TurningToFinal";
turningToFinal.source = turning;
turningToFinal.target = finalMode;
turningToFinal.trigger = endTask;
turningToFinal.guard = "";
turningToFinal.action = "Move(0, 0)";
stateMachine.transitions.add(turningToFinal);
