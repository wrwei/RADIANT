stm SRangerController {
    event obstacle
    event tick
    event endTask
    event Move
    var obstacleDetected : boolean
    var linearVelocity : real
    var angularVelocity : real
    const moveVel : real = 1.0
    const turnVel : real = 2.0
    const obstacleThreshold : real = 0.5
    const turnDuration : real = 2.0
    clock clockResetTime
    initial i0
    state Moving {
        entry linearVelocity = moveVel; angularVelocity = 0.0; Move
    }
    state Turning {
        entry linearVelocity = 0.0; angularVelocity = turnVel; Move
    }
    final Final
    transition t0 { from i0 to Moving }
    transition t1 { from Moving to Turning trigger obstacle #clockResetTime condition obstacleDetected }
    transition t2 { from Moving to Final trigger endTask action linearVelocity = 0.0; angularVelocity = 0.0; Move }
    transition t3 { from Moving to Moving trigger tick }
    transition t4 { from Turning to Moving condition since_clockResetTime >= turnDuration }
    transition t5 { from Turning to Final trigger endTask action linearVelocity = 0.0; angularVelocity = 0.0; Move }
    transition t6 { from Turning to Turning trigger tick }
}