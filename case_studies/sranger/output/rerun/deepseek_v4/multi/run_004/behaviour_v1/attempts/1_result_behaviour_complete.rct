diagram SRanger

interface Inputs {
	event obstacle
	event endTask
	event tick
}

interface Outputs {
	event Move
}

interface SRanger_State {
	var obstacleDetected : boolean
	var since_taskClock : real
	var linearVelocity : real
	var angularVelocity : real
}

interface Constants {
	const clockResetTime : real = 1
	const turnDuration : real = 1
	const moveVel : real = 1
	const turnVel : real = 1
}

stm SRanger {
	uses Inputs uses Outputs requires SRanger_State requires Constants
	clock taskClock
	state Moving {
		entry linearVelocity = moveVel ; angularVelocity = 0 ; send Move
	}
	state Turning {
		entry linearVelocity = 0 ; angularVelocity = turnVel ; since_taskClock = clockResetTime ; send Move
	}
	state Final {
		entry linearVelocity = 0 ; angularVelocity = 0 ; send Move
	}
	initial i0
	transition t0 {
		from i0
		to Moving
	}
	transition t1 {
		from Moving
		to Turning
		trigger obstacle
		condition obstacleDetected
	}
	transition t2 {
		from Moving
		to Final
		trigger endTask
	}
	transition t3 {
		from Moving
		to Moving
		trigger tick
	}
	transition t4 {
		from Turning
		to Moving
		condition since_taskClock - clockResetTime >= turnDuration
	}
	transition t5 {
		from Turning
		to Final
		trigger endTask
	}
	transition t6 {
		from Turning
		to Turning
		trigger tick
	}
	transition t7 {
		from Final
		to Final
		trigger tick
	}
}

controller SRanger_Ctrl {
	uses Inputs uses Outputs requires SRanger_State requires Constants
	sref stm_ref0 = SRanger
	connection SRanger_Ctrl on obstacle to stm_ref0 on obstacle
	connection SRanger_Ctrl on endTask to stm_ref0 on endTask
	connection SRanger_Ctrl on tick to stm_ref0 on tick
	connection stm_ref0 on Move to SRanger_Ctrl on Move
}

module SRanger_Module {
	robotic platform SRanger_Platform {
		provides Constants
		event obstacle
		event endTask
		event tick
		event Move
	}
	cref ctrl_ref0 = SRanger_Ctrl
	connection SRanger_Platform on obstacle to ctrl_ref0 on obstacle
	connection SRanger_Platform on endTask to ctrl_ref0 on endTask
	connection SRanger_Platform on tick to ctrl_ref0 on tick
	connection ctrl_ref0 on Move to SRanger_Platform on Move
}
